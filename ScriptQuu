---------------------------------------------------------------- UI HELPERS
local ON, OFF = Color3.fromRGB(46, 160, 90), Color3.fromRGB(58, 58, 74)
local BG, PANEL = Color3.fromRGB(22, 22, 30), Color3.fromRGB(32, 32, 44)
local W = Color3.new(1, 1, 1)

local order = 0
local function nextOrder()
	order += 1
	return order
end

local function new(class, props, parent)
	local o = Instance.new(class)
	for k, v in props do o[k] = v end
	o.Parent = parent
	return o
end

local function corner(o, r)
	new("UICorner", { CornerRadius = UDim.new(0, r or 6) }, o)
end

local function pad(o, n)
	new("UIPadding", {
		PaddingTop = UDim.new(0, n), PaddingBottom = UDim.new(0, n),
		PaddingLeft = UDim.new(0, n), PaddingRight = UDim.new(0, n),
	}, o)
end

local function list(o, gap)
	new("UIListLayout", { Padding = UDim.new(0, gap), SortOrder = Enum.SortOrder.LayoutOrder }, o)
end

local function mkToggle(parent, size, label, init, cb, pos)
	local on = init
	local b = new("TextButton", {
		Size = size, Position = pos or UDim2.new(), LayoutOrder = nextOrder(), AutoButtonColor = false,
		Text = "", TextColor3 = W, Font = Enum.Font.GothamMedium, TextSize = 14, BackgroundColor3 = OFF,
	}, parent)
	corner(b)
	local function render()
		b.BackgroundColor3 = on and ON or OFF
		b.Text = label .. " : " .. (on and "On" or "Off")
	end
	render()
	b.MouseButton1Click:Connect(function()
		on = not on
		render()
		cb(on)
	end)
	return b, function(v) on = v; render() end
end

local function mkCycle(parent, size, label, opts, init, cb)
	local idx = table.find(opts, init) or 1
	local b = new("TextButton", {
		Size = size, LayoutOrder = nextOrder(), AutoButtonColor = false, BackgroundColor3 = OFF,
		TextColor3 = W, Font = Enum.Font.GothamMedium, TextSize = 14,
		Text = label .. " : " .. tostring(opts[idx]),
	}, parent)
	corner(b)
	b.MouseButton1Click:Connect(function()
		idx = idx % #opts + 1
		b.Text = label .. " : " .. tostring(opts[idx])
		cb(opts[idx])
	end)
end

local function draggable(handle, target, onClick)
	local dragging, startMouse, startPos, moved = false, nil, nil, 0
	handle.InputBegan:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
			dragging, moved = true, 0
			startMouse, startPos = i.Position, target.Position
			i.Changed:Connect(function()
				if i.UserInputState == Enum.UserInputState.End then
					if dragging and onClick and moved < 6 then onClick() end
					dragging = false
				end
			end)
		end
	end)
	UIS.InputChanged:Connect(function(i)
		if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
			local d = i.Position - startMouse
			moved = math.max(moved, d.Magnitude)
			target.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
		end
	end)
end

