local hitSnd = new("Sound", {SoundId = "rbxasset://sounds/electronicpingshort.wav", Volume = 1, PlaybackSpeed = 1.7}, SoundService)
local lastShot = 0

UIS.InputBegan:Connect(function(i, gp)
	if gp then return end
	if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
		lastShot = os.clock()
	end
end)

local function showHit()
	local col = COLORS[cfg.hitColor] or COLORS[2]
	local s = cfg.hitSize
	local off = 5 + s * 0.35
	for _, sx in ipairs({1, -1}) do
		for _, sy in ipairs({1, -1}) do
			local f = new("Frame", {
				AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, sx * off, 0.5, sy * off),
				Size = UDim2.new(0, s, 0, 2), Rotation = (sx * sy == 1) and 45 or -45,
				BackgroundColor3 = col, BorderSizePixel = 0, ZIndex = 6,
			}, gui)
			local tw = TweenService:Create(f, TweenInfo.new(0.3), {BackgroundTransparency = 1})
			tw:Play()
			tw.Completed:Connect(function() f:Destroy() end)
		end
	end
	if cfg.hitSound then
		hitSnd:Play()
	end
end

local function watch(p)
	if p == lp then return end
	local function hook(ch)
		local hum = ch:WaitForChild("Humanoid", 5)
		if not hum then return end
		local last = hum.Health
		hum.HealthChanged:Connect(function(h)
			if h < last and cfg.hit and os.clock() - lastShot < 0.5 and lp.Character and lp.Character:FindFirstChildOfClass("Tool") then
				showHit()
			end
			last = h
		end)
	end
	if p.Character then task.spawn(hook, p.Character) end
	p.CharacterAdded:Connect(hook)
end
for _, p in ipairs(Players:GetPlayers()) do watch(p) end
Players.PlayerAdded:Connect(watch)

