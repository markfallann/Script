local HEADLESS, KORBLOX = 134082579, 139607718
local origDesc

local function applyKorles()
	local ch = lp.Character
	local hum = ch and ch:FindFirstChildOfClass("Humanoid")
	if not hum then return end
	local ok, desc = pcall(function() return hum:GetAppliedDescription() end)
	if not ok then return end
	origDesc = origDesc or {Head = desc.Head, RightLeg = desc.RightLeg}
	local m = cfg.kMode
	local hl = cfg.korles and (m == "all" or m == "headless")
	local kb = cfg.korles and (m == "all" or m == "korblox")
	desc.Head = hl and HEADLESS or origDesc.Head
	desc.RightLeg = kb and KORBLOX or origDesc.RightLeg
	local okA = pcall(function() hum:ApplyDescription(desc) end)
	if not okA then
		local head = ch:FindFirstChild("Head")
		if head then
			head.Transparency = hl and 1 or 0
			local f = head:FindFirstChildOfClass("Decal")
			if f then f.Transparency = hl and 1 or 0 end
		end
	end
end

