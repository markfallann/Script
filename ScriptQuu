local TXT, DIM, LINE = Color3.fromRGB(235, 235, 235), Color3.fromRGB(120, 120, 120), Color3.fromRGB(45, 45, 45)

local function new(class, props, parent)
	local i = Instance.new(class)
	for k, v in pairs(props) do i[k] = v end
	i.Parent = parent
	return i
end
local function round(i, r) new("UICorner", {CornerRadius = UDim.new(0, r or 6)}, i) end
local function stroke(i) new("UIStroke", {Color = LINE, Thickness = 1}, i) end

