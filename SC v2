local cache = {}
local function clear(p)
	local c = cache[p]
	if c then for _, o in ipairs(c.objs) do o:Destroy() end cache[p] = nil end
end

local function build(p, char)
	clear(p)
	local objs = {}
	local hl = Instance.new("Highlight")
	hl.Adornee = char
	hl.FillTransparency = 0.5
	hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	hl.Parent = espFolder
	table.insert(objs, hl)

	local head = char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")
	local bb = Instance.new("BillboardGui")
	bb.Adornee = head
	bb.Size = UDim2.new(0,120,0,20)
	bb.StudsOffset = Vector3.new(0,2.5,0)
	bb.AlwaysOnTop = true
	bb.Parent = espFolder
	table.insert(objs, bb)
	local tl = Instance.new("TextLabel", bb)
	tl.Size = UDim2.new(1,0,1,0)
	tl.BackgroundTransparency = 1
	tl.Font = Enum.Font.GothamBold
	tl.TextSize = 14
	tl.TextStrokeTransparency = 0
	tl.Text = p.DisplayName

	local boxes = {}
	for _, part in ipairs(char:GetChildren()) do
		if part:IsA("BasePart") then
			local b = Instance.new("BoxHandleAdornment")
			b.Adornee = part
			b.Size = part.Size
			b.AlwaysOnTop = true
			b.ZIndex = 5
			b.Transparency = 0.5
			b.Parent = espFolder
			table.insert(objs, b)
			table.insert(boxes, b)
		end
	end
	cache[p] = {char=char, hl=hl, bb=bb, tl=tl, boxes=boxes, objs=objs}
end

