-- ===== FLY / INF JUMP / CLICK TP =====
do
	local bv, bg
	local function stopFly()
		if bv then bv:Destroy() bv = nil end
		if bg then bg:Destroy() bg = nil end
		local h = lp.Character and lp.Character:FindFirstChildOfClass("Humanoid")
		if h then h.PlatformStand = false end
	end
	U1.tg("Fly", "Fly", function(v) if not v then stopFly() end end)
	U1.num("Fly Speed", "FlySpeed", 1, 500)
	U1.tg("Infinite Jump", "InfJump")
	U1.tg("Click TP", "ClickTP")

	on(RunService.RenderStepped, function()
		if not S.Fly then return end
		local char = lp.Character
		local root = char and char:FindFirstChild("HumanoidRootPart")
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		if not (root and hum) then return end
		if not bv or bv.Parent ~= root then
			stopFly()
			bv = new("BodyVelocity", {MaxForce = Vector3.new(1e9, 1e9, 1e9), Velocity = Vector3.zero}, root)
			bg = new("BodyGyro", {MaxTorque = Vector3.new(1e9, 1e9, 1e9), P = 1e4}, root)
		end
		hum.PlatformStand = true
		local md = cam.CFrame:VectorToObjectSpace(hum.MoveDirection)
		local v = cam.CFrame.RightVector * md.X + cam.CFrame.LookVector * (-md.Z)
		if UIS:IsKeyDown(Enum.KeyCode.Space) or UIS:IsKeyDown(Enum.KeyCode.E) then v += Vector3.new(0, 1, 0) end
		if UIS:IsKeyDown(Enum.KeyCode.LeftControl) or UIS:IsKeyDown(Enum.KeyCode.Q) then v -= Vector3.new(0, 1, 0) end
		bv.Velocity = v * S.FlySpeed
		bg.CFrame = cam.CFrame
	end)

	on(UIS.JumpRequest, function()
		if not S.InfJump then return end
		local h = lp.Character and lp.Character:FindFirstChildOfClass("Humanoid")
		if h then h:ChangeState(Enum.HumanoidStateType.Jumping) end
	end)

	local mouse = lp:GetMouse()
	local function tpTo(pos)
		local r = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
		if r then r.CFrame = CFrame.new(pos + Vector3.new(0, 3, 0)) end
	end
	on(UIS.InputBegan, function(i, gp)
		if gp or not S.ClickTP then return end
		if i.UserInputType == Enum.UserInputType.MouseButton1 and mouse.Target then tpTo(mouse.Hit.Position) end
	end)
	on(UIS.TouchTapInWorld, function(_, gp)
		if not gp and S.ClickTP and mouse.Target then tpTo(mouse.Hit.Position) end
	end)
end

