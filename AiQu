local busy = false
local function submit()
	if busy then return end
	local t = box.Text:match("^%s*(.-)%s*$")
	if t == "" then return end
	busy = true
	box.Text = ""
	addBubble(t, true)
	table.insert(history, {role = "user", content = t})
	while #history > 10 do table.remove(history, 1) end

	local msgs = {{role = "system", content = SYSTEM}}
	for _, m in ipairs(history) do table.insert(msgs, m) end

	local p1, fr = withSkeleton(msgs, 900)
	if not p1 then
		table.remove(history)
		addBubble("Error: " .. tostring(fr), false)
		busy = false
		return
	end
	addBubble(p1, false)
	local full = p1

	if fr == "length" then
		table.insert(msgs, {role = "assistant", content = p1})
		table.insert(msgs, {role = "user", content = "Lanjutkan tepat dari potongan terakhir. Jangan ulangi, tanpa pembuka. Selesaikan sampai akhir."})
		local p2, e2 = withSkeleton(msgs, 2000)
		if p2 then
			addBubble(p2, false)
			full = full .. p2
		else
			addBubble("Error bagian 2: " .. tostring(e2), false)
		end
	end

	table.insert(history, {role = "assistant", content = full})
	runBuild(full)
	busy = false
end

