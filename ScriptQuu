	Font = Enum.Font.GothamBold, TextSize = 13, AutoButtonColor = false,
}, exportRow)
corner(exportBtn)
local importBtn = new("TextButton", {
	Size = UDim2.new(0.5, -4, 1, 0), Position = UDim2.new(0.5, 4, 0, 0), BackgroundColor3 = OFF,
	Text = "Import Config", TextColor3 = W, Font = Enum.Font.GothamBold, TextSize = 13, AutoButtonColor = false,
}, exportRow)
corner(importBtn)

local importRow = new("Frame", { Size = UDim2.new(1, 0, 0, 60), BackgroundTransparency = 1, LayoutOrder = nextOrder() }, adminPage)
local importBox = new("TextBox", {
	Size = UDim2.new(1, 0, 1, 0), BackgroundColor3 = OFF, Text = "", PlaceholderText = "Tempel config di sini...",
	TextColor3 = W, PlaceholderColor3 = Color3.fromRGB(170, 170, 180), Font = Enum.Font.Gotham, TextSize = 12,
	ClearTextOnFocus = false, MultiLine = true, TextWrapped = true,
}, importRow)
corner(importBox)
pad(importBox, 6)

exportBtn.MouseButton1Click:Connect(function()
	local data = HttpService:JSONEncode({ E = E, X = X, T = T, Tools = Tools, Zoom = Zoom, Misc = Misc })
	importBox.Text = data
	pcall(function() setclipboard(data) end)
	notify("Config disalin ke clipboard")
end)
importBtn.MouseButton1Click:Connect(function()
	local ok, data = pcall(function() return HttpService:JSONDecode(importBox.Text) end)
	if not ok or not data then notify("Config tidak valid") return end
	for k, v in data.E or {} do E[k] = v end
	for k, v in data.X or {} do X[k] = v end
	for k, v in data.T or {} do T[k] = v end
	for k, v in data.Tools or {} do Tools[k] = v end
	for k, v in data.Zoom or {} do Zoom[k] = v end
	for k, v in data.Misc or {} do Misc[k] = v end
	notify("Config berhasil di-import")
end)

