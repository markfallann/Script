local COLORS = {Color3.fromRGB(255, 255, 255), Color3.fromRGB(255, 60, 60), Color3.fromRGB(60, 255, 90), Color3.fromRGB(60, 220, 255), Color3.fromRGB(255, 230, 60)}
local chHolder = new("Frame", {AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0.5, 0), Size = UDim2.new(0, 0, 0, 0), BackgroundTransparency = 1, ZIndex = 5}, gui)

local function drawCross()
	chHolder:ClearAllChildren()
	chHolder.Visible = cfg.cross
	local col = COLORS[cfg.crossColor] or COLORS[1]
	local s = cfg.crossSize
	local function bar(ax, ay, px, py, w, h)
		new("Frame", {AnchorPoint = Vector2.new(ax, ay), Position = UDim2.new(0, px, 0, py), Size = UDim2.new(0, w, 0, h), BackgroundColor3 = col, BorderSizePixel = 0}, chHolder)
	end
	if cfg.crossShape == "plus" then
		bar(1, 0.5, -4, 0, s, 2) bar(0, 0.5, 4, 0, s, 2) bar(0.5, 1, 0, -4, 2, s) bar(0.5, 0, 0, 4, 2, s)
	elseif cfg.crossShape == "dot" then
		local d = math.max(3, s / 2)
		local f = new("Frame", {AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.new(0, d, 0, d), BackgroundColor3 = col, BorderSizePixel = 0}, chHolder)
		round(f, 100)
	else
		local c = new("Frame", {AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.new(0, s * 2, 0, s * 2), BackgroundTransparency = 1}, chHolder)
		new("UIStroke", {Color = col, Thickness = 2}, c)
		round(c, 100)
	end
end

