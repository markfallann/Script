	p.CanTouch = false
	p.Material = Enum.Material.Neon
	p.Color = Color3.fromRGB(0,200,255)
	p.Position = pos + Vector3.new(0,1.5,0)
	p.Parent = wpFolder
	local bb = Instance.new("BillboardGui", p)
	bb.Size = UDim2.new(0,30,0,30)
	bb.StudsOffset = Vector3.new(0,1.5,0)
	bb.AlwaysOnTop = true
