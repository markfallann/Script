-- ===== MARK CAM (MENU 2) =====
do
	local okV, VIM = pcall(function() return game:GetService("VirtualInputManager") end)
	local mouse2 = lp:GetMouse()
	local R = {}

	local m2 = new("Frame", {
		Size = UDim2.new(0, 220, 0, 340), Position = UDim2.new(1, -230, 0, 60),
		BackgroundColor3 = C_BG, BorderSizePixel = 0,
	}, g2)
	corner(m2, 8)
	local title = new("TextLabel", {
		Size = UDim2.new(1, 0, 0, 28), BackgroundColor3 = Color3.fromRGB(40, 40, 40), BorderSizePixel = 0,
		Text = "Mark Cam  [F6 / F7 / F8]", TextColor3 = WHITE, Font = Enum.Font.GothamBold, TextSize = 13,
	}, m2)
	corner(title, 8)
	drag(title, m2)
	local body = new("ScrollingFrame", {
		Position = UDim2.new(0, 0, 0, 32), Size = UDim2.new(1, 0, 1, -34), BackgroundTransparency = 1,
		BorderSizePixel = 0, CanvasSize = UDim2.new(0, 0, 0, 0), AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollBarThickness = 4,
	}, m2)
	new("UIListLayout", {Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder, HorizontalAlignment = Enum.HorizontalAlignment.Center}, body)
	local U2 = makeUI(body, S2)

	-- freecam + zoom
	local FC = {on = false, pos = Vector3.zero, yaw = 0, pitch = 0}
	local saved = {}
	local touchD = Vector2.zero
	local zoomActive, fovSaved = false, 70

	local function startFreecam()
		if FC.on then return end
		local rx, ry = cam.CFrame:ToOrientation()
		FC.pos = cam.CFrame.Position
		FC.pitch, FC.yaw = rx, ry
		saved.aim = S.Aim
		S.Aim = false
		local root = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
		saved.root = root
		if root then
			saved.anch = root.Anchored
			root.Anchored = true
		end
		cam.CameraType = Enum.CameraType.Scriptable
		FC.on = true
	end
	local function stopFreecam()
		if not FC.on then return end
		FC.on = false
		UIS.MouseBehavior = Enum.MouseBehavior.Default
		cam.CameraType = Enum.CameraType.Custom
		if saved.root then saved.root.Anchored = saved.anch or false end
		S.Aim = saved.aim or false
		local h = lp.Character and lp.Character:FindFirstChildOfClass("Humanoid")
		if h then cam.CameraSubject = h end
	end
	M.onKill = stopFreecam

	on(UIS.InputChanged, function(i, gp)
		if i.UserInputType == Enum.UserInputType.MouseWheel then
			if S2.Zoom and not gp then S2.ZoomFOV = math.clamp(S2.ZoomFOV - i.Position.Z * 3, 5, 120) end
		elseif i.UserInputType == Enum.UserInputType.Touch and FC.on and not gp then
			touchD += Vector2.new(i.Delta.X, i.Delta.Y)
		end
	end)

	on(RunService.RenderStepped, function(dt)
		if FC.on then
			if UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then
				UIS.MouseBehavior = Enum.MouseBehavior.LockCurrentPosition
				local d = UIS:GetMouseDelta()
				FC.yaw -= math.rad(d.X * 0.25)
				FC.pitch = math.clamp(FC.pitch - math.rad(d.Y * 0.25), -1.5, 1.5)
			else
				UIS.MouseBehavior = Enum.MouseBehavior.Default
			end
			if touchD.Magnitude > 0 then
				FC.yaw -= math.rad(touchD.X * 0.3)
				FC.pitch = math.clamp(FC.pitch - math.rad(touchD.Y * 0.3), -1.5, 1.5)
				touchD = Vector2.zero
			end
			local cf = CFrame.new(FC.pos) * CFrame.fromOrientation(FC.pitch, FC.yaw, 0)
			local mv = Vector3.zero
			if UIS.KeyboardEnabled then
				if not UIS:GetFocusedTextBox() then
					if UIS:IsKeyDown(Enum.KeyCode.W) then mv += cf.LookVector end
					if UIS:IsKeyDown(Enum.KeyCode.S) then mv -= cf.LookVector end
					if UIS:IsKeyDown(Enum.KeyCode.D) then mv += cf.RightVector end
					if UIS:IsKeyDown(Enum.KeyCode.A) then mv -= cf.RightVector end
					if UIS:IsKeyDown(Enum.KeyCode.E) then mv += Vector3.new(0, 1, 0) end
					if UIS:IsKeyDown(Enum.KeyCode.Q) then mv -= Vector3.new(0, 1, 0) end
				end
			else
				local h = lp.Character and lp.Character:FindFirstChildOfClass("Humanoid")
				if h then
					local md = cf:VectorToObjectSpace(h.MoveDirection)
					mv = cf.RightVector * md.X + cf.LookVector * (-md.Z)
				end
			end
			local spd = S2.FCSpeed * (UIS:IsKeyDown(Enum.KeyCode.LeftShift) and 3 or 1)
			FC.pos += mv * spd * dt
			cam.CFrame = CFrame.new(FC.pos) * CFrame.fromOrientation(FC.pitch, FC.yaw, 0)
		end
		if S2.Zoom then cam.FieldOfView = S2.ZoomFOV end
	end)

	-- auto click
	local points = {}
	local acToken = 0

	local function updateMarkers()
		for _, m in ipairs(points) do
			m.Visible = g2.Enabled and not S2.ClickOn
		end
	end
	local function addPoint()
		local m = new("TextButton", {
			AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.new(0, 34, 0, 34),
			Position = UDim2.new(0.5, #points * 16, 0.5, #points * 16),
			BackgroundColor3 = Color3.fromRGB(255, 60, 60), BackgroundTransparency = 0.25,
			TextColor3 = WHITE, Font = Enum.Font.GothamBold, TextSize = 16, AutoButtonColor = false, ZIndex = 10,
		}, ov)
		corner(m, 0, 1)
		points[#points + 1] = m
		m.Text = tostring(#points)
		drag(m, m)
		updateMarkers()
	end
	local function doClick(x, y)
		local ok = okV and pcall(function()
			VIM:SendMouseButtonEvent(x, y, 0, true, game, 0)
			task.wait(0.03)
			VIM:SendMouseButtonEvent(x, y, 0, false, game, 0)
		end)
		if not ok and mousemoveabs and mouse1click then
			pcall(function() mousemoveabs(x, y) mouse1click() end)
		end
	end
	local function startClick()
		acToken += 1
		local my = acToken
		task.spawn(function()
			while M.alive and S2.ClickOn and acToken == my and #points > 0 do
				for _, m in ipairs(points) do
					if not (S2.ClickOn and acToken == my) then break end
					if m.Parent then
						local c = m.AbsolutePosition + m.AbsoluteSize / 2
						doClick(c.X, c.Y)
					end
					task.wait(math.max(S2.ClickDelay, 0.02))
				end
				if not S2.ClickLoop then break end
			end
			if acToken == my and S2.ClickOn then R.Click(false) end
		end)
	end

	-- slide
	local wps = {}
	local slideIdx = 1
	local wpFolder = track(new("Folder", {Name = "MarkSlide"}, workspace))
	local function addWP(pos)
		local p = new("Part", {
			Shape = Enum.PartType.Ball, Size = Vector3.new(1.5, 1.5, 1.5), Anchored = true, CanCollide = false,
			CanQuery = false, CanTouch = false, Material = Enum.Material.Neon, Color = Color3.fromRGB(0, 200, 255),
			Position = pos + Vector3.new(0, 1.5, 0),
		}, wpFolder)
		local bb = new("BillboardGui", {Size = UDim2.new(0, 30, 0, 30), StudsOffset = Vector3.new(0, 1.5, 0), AlwaysOnTop = true}, p)
		new("TextLabel", {
			Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, Font = Enum.Font.GothamBold, TextSize = 18,
			TextColor3 = WHITE, TextStrokeTransparency = 0, Text = tostring(#wps + 1),
		}, bb)
		wps[#wps + 1] = p
	end
	on(UIS.InputBegan, function(i, gp)
		if gp then return end
		if S2.Pick and i.UserInputType == Enum.UserInputType.MouseButton1 and mouse2.Target then
			addWP(mouse2.Hit.Position)
		end
	end)
	on(UIS.TouchTapInWorld, function(_, gp)
		if not gp and S2.Pick and mouse2.Target then addWP(mouse2.Hit.Position) end
	end)
	on(RunService.Heartbeat, function(dt)
		if not S2.Slide then return end
		if #wps == 0 then R.Slide(false) return end
		local root = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
		local target = wps[slideIdx]
		if not (root and target) then return end
		local tpos = target.Position + Vector3.new(0, 1.5, 0)
		local cur = root.Position
		local diff = tpos - cur
		local dist = diff.Magnitude
		local step = S2.SlideSpeed * dt
		local newPos = dist <= step and tpos or cur + diff.Unit * step
		local flat = Vector3.new(diff.X, 0, diff.Z)
		if flat.Magnitude > 0.05 then
			root.CFrame = CFrame.lookAt(newPos, newPos + flat)
		else
			root.CFrame = CFrame.new(newPos)
		end
		root.AssemblyLinearVelocity = Vector3.zero
		if dist <= step then
			slideIdx += 1
			if slideIdx > #wps then
				if S2.SlideLoop then slideIdx = 1 else R.Slide(false) end
			end
		end
	end)

	-- isi menu 2
	R.Freecam = U2.tg("Freecam", "Freecam", function(v)
		if v then startFreecam() else stopFreecam() end
	end)
	U2.num("Cam Speed", "FCSpeed", 1, 500)
	R.Zoom = U2.tg("Zoom (scroll)", "Zoom", function(v)
		if v and not zoomActive then
			zoomActive = true
			fovSaved = cam.FieldOfView
		elseif not v and zoomActive then
			zoomActive = false
			cam.FieldOfView = fovSaved
		end
	end)
	U2.num("Zoom FOV", "ZoomFOV", 5, 120)

	U2.sep("— AUTO CLICK —")
	U2.btn("+ Tambah Lokasi (geser titik)", addPoint)
	U2.btn("Hapus Lokasi Terakhir", function()
		local m = table.remove(points)
		if m then m:Destroy() end
	end)
	U2.btn("Hapus Semua Lokasi", function()
		for _, m in ipairs(points) do m:Destroy() end
		table.clear(points)
	end)
	U2.num("Delay Klik (detik)", "ClickDelay", 0.02, 60)
	U2.tg("Loop Klik", "ClickLoop")
	R.Click = U2.tg("Auto Click (F7)", "ClickOn", function(v)
		if v then startClick() else acToken += 1 end
		updateMarkers()
	end)

	U2.sep("— SLIDE —")
	U2.tg("Pilih Area (tap map)", "Pick")
	U2.btn("Hapus Titik Terakhir", function()
		local p = table.remove(wps)
		if p then p:Destroy() end
	end)
	U2.btn("Hapus Semua Titik", function()
		for _, p in ipairs(wps) do p:Destroy() end
		table.clear(wps)
	end)
	U2.num("Slide Speed", "SlideSpeed", 1, 500)
	U2.tg("Loop Slide", "SlideLoop")
	R.Slide = U2.tg("Slide (F8)", "Slide", function(v)
		if v then slideIdx = 1 end
	end)

	function M.setCamMode(v)
		g2.Enabled = v
		R.Freecam(v)
		R.Zoom(v)
		updateMarkers()
	end

	on(UIS.InputBegan, function(i, gp)
		if gp then return end
		if i.KeyCode == Enum.KeyCode.F6 then
			M.setCamMode(not g2.Enabled)
		elseif i.KeyCode == Enum.KeyCode.F7 then
			R.Click(not S2.ClickOn)
		elseif i.KeyCode == Enum.KeyCode.F8 then
			R.Slide(not S2.Slide)
		end
	end)
end
