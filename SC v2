-- ===== FREECAM + ZOOM =====
local FC = {on=false, pos=Vector3.zero, yaw=0, pitch=0}
local saved = {}
local touchD = Vector2.zero
local zoomActive = false
local fovSaved = 70

local function startFreecam()
	if FC.on then return end
	local cf = cam.CFrame
	FC.pos = cf.Position
	local rx, ry = cf:ToOrientation()
	FC.pitch, FC.yaw = rx, ry
	saved.aim = S.Aim
	S.Aim = false
	local root = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
	saved.root = root
	if root then saved.anch = root.Anchored root.Anchored = true end
	cam.CameraType = Enum.CameraType.Scriptable
	FC.on = true
end

local function stopFreecam()
	if not FC.on then return end
	FC.on = false
	UIS.MouseBehavior = Enum.MouseBehavior.Default
	cam.CameraType = Enum.CameraType.Custom
	if saved.root then saved.root.Anchored = saved.anch or false end
	S.Aim = saved.aim or false
	local h = lp.Character and lp.Character:FindFirstChildOfClass("Humanoid")
	if h then cam.CameraSubject = h end
end

UIS.InputChanged:Connect(function(i, gp)
	if i.UserInputType == Enum.UserInputType.MouseWheel then
		if S2.Zoom and not gp then S2.ZoomFOV = math.clamp(S2.ZoomFOV - i.Position.Z * 3, 5, 120) end
	elseif i.UserInputType == Enum.UserInputType.Touch and FC.on and not gp then
		touchD += Vector2.new(i.Delta.X, i.Delta.Y)
	end
end)

RunService.RenderStepped:Connect(function(dt)
	if FC.on then
		if UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then
			UIS.MouseBehavior = Enum.MouseBehavior.LockCurrentPosition
			local d = UIS:GetMouseDelta()
			FC.yaw -= math.rad(d.X * 0.25)
			FC.pitch = math.clamp(FC.pitch - math.rad(d.Y * 0.25), -1.5, 1.5)
		else
			UIS.MouseBehavior = Enum.MouseBehavior.Default
		end
		if touchD.Magnitude > 0 then
			FC.yaw -= math.rad(touchD.X * 0.3)
			FC.pitch = math.clamp(FC.pitch - math.rad(touchD.Y * 0.3), -1.5, 1.5)
			touchD = Vector2.zero
		end
		local cf = CFrame.new(FC.pos) * CFrame.fromOrientation(FC.pitch, FC.yaw, 0)
		local mv = Vector3.zero
		if UIS.KeyboardEnabled then
			if not UIS:GetFocusedTextBox() then
				if UIS:IsKeyDown(Enum.KeyCode.W) then mv += cf.LookVector end
				if UIS:IsKeyDown(Enum.KeyCode.S) then mv -= cf.LookVector end
				if UIS:IsKeyDown(Enum.KeyCode.D) then mv += cf.RightVector end
				if UIS:IsKeyDown(Enum.KeyCode.A) then mv -= cf.RightVector end
				if UIS:IsKeyDown(Enum.KeyCode.E) then mv += Vector3.new(0,1,0) end
				if UIS:IsKeyDown(Enum.KeyCode.Q) then mv -= Vector3.new(0,1,0) end
			end
		else
			local h = lp.Character and lp.Character:FindFirstChildOfClass("Humanoid")
			if h then
				local md = cf:VectorToObjectSpace(h.MoveDirection)
				mv = cf.RightVector * md.X + cf.LookVector * (-md.Z)
			end
		end
		local spd = S2.FCSpeed * (UIS:IsKeyDown(Enum.KeyCode.LeftShift) and 3 or 1)
		FC.pos += mv * spd * dt
		cam.CFrame = CFrame.new(FC.pos) * CFrame.fromOrientation(FC.pitch, FC.yaw, 0)
	end
	if S2.Zoom then cam.FieldOfView = S2.ZoomFOV end
end)

