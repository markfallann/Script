local lp = Players.LocalPlayer
local STUD_TO_M = 0.28

---------------------------------------------------------------- CONFIG
local function feat(extra)
	local t = { On = false, Color = Color3.fromRGB(255, 60, 60), TeamColor = true, WallCheck = true }
	for k, v in extra do t[k] = v end
	return t
end

local F = {
	Esp = feat({ Fill = true }),
	Name = feat({ Color = Color3.fromRGB(255, 255, 255), Display = true }),
	Dist = feat({ Color = Color3.fromRGB(255, 255, 255), Unit = "Meter" }),
	Tracer = feat({ Origin = "Bawah", Thick = 2 }),
}

---------------------------------------------------------------- ESP CORE
local cache = {}
local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude

local function isVisible(char, target, cam)
	local filter = { char }
	if lp.Character then table.insert(filter, lp.Character) end
	rayParams.FilterDescendantsInstances = filter
	local origin = cam.CFrame.Position
	return workspace:Raycast(origin, target.Position - origin, rayParams) == nil
end

local function colorFor(p, cfg)
	if cfg.TeamColor and p.Team then
		return p.Team.TeamColor.Color
	end
	return cfg.Color
end

local function drop(p)
	local c = cache[p]
	if not c then return end
	if c.sel then c.sel:Destroy() end
	if c.tag then c.tag:Destroy() end
	if c.line then c.line:Destroy() end
	cache[p] = nil
end

local tracerGui = Instance.new("ScreenGui")
tracerGui.Name = "SQ_Tracer"
tracerGui.ResetOnSpawn = false
tracerGui.IgnoreGuiInset = true
tracerGui.Parent = lp:WaitForChild("PlayerGui")

local function mkLabel(parent, y)
	local l = Instance.new("TextLabel")
	l.Size = UDim2.new(1, 0, 0, 18)
	l.Position = UDim2.fromOffset(0, y)
	l.BackgroundTransparency = 1
	l.Font = Enum.Font.GothamBold
	l.TextSize = 14
	l.TextStrokeTransparency = 0.3
	l.Text = ""
	l.Parent = parent
	return l
end

local function update(p, cam)
	local char = p.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local root = char and char:FindFirstChild("HumanoidRootPart")
	local head = char and char:FindFirstChild("Head")
	local any = F.Esp.On or F.Name.On or F.Dist.On or F.Tracer.On

	if not any or not hum or hum.Health <= 0 or not root or not head then
		drop(p)
		return
	end

	local c = cache[p]
	if c and c.char ~= char then
		drop(p)
		c = nil
	end
	if not c then
		c = { char = char }
		cache[p] = c
	end

	local vis
	local function visible(cfg)
		if not cfg.WallCheck then return true end
		if vis == nil then
			vis = isVisible(char, root, cam) or isVisible(char, head, cam)
		end
		return vis
	end

	-- ESP BADAN (satu kotak utuh)
	local e = F.Esp
	if e.On then
		if not c.sel or not c.sel.Parent then
			local s = Instance.new("SelectionBox")
			s.Name = "SQ_Esp"
			s.Adornee = char
			s.LineThickness = 0.04
			s.Parent = char
			c.sel = s
		end
		local col = colorFor(p, e)
		c.sel.Color3 = col
		c.sel.SurfaceColor3 = col
		c.sel.SurfaceTransparency = e.Fill and 0.8 or 1
		c.sel.Visible = visible(e)
	elseif c.sel then
		c.sel:Destroy()
		c.sel = nil
	end

	-- NAMA + JARAK
	local n, d = F.Name, F.Dist
	if n.On or d.On then
		if not c.tag or not c.tag.Parent then
			local tag = Instance.new("BillboardGui")
			tag.Name = "SQ_Tag"
			tag.Size = UDim2.fromOffset(160, 36)
			tag.StudsOffset = Vector3.new(0, 3, 0)
			tag.AlwaysOnTop = true
			tag.Adornee = head
			c.nameL = mkLabel(tag, 0)
			c.distL = mkLabel(tag, 18)
			tag.Parent = head
			c.tag = tag
		end
		c.nameL.Visible = n.On and visible(n)
		if n.On then
			c.nameL.Text = n.Display and p.DisplayName or p.Name
			c.nameL.TextColor3 = colorFor(p, n)
		end
		c.distL.Position = UDim2.fromOffset(0, n.On and 18 or 9)
		c.distL.Visible = d.On and visible(d)
		if d.On then
			local lroot = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
			local from = lroot and lroot.Position or cam.CFrame.Position
			local studs = (root.Position - from).Magnitude
			if d.Unit == "Meter" then
				c.distL.Text = math.floor(studs * STUD_TO_M) .. "m"
			else
				c.distL.Text = math.floor(studs) .. " stud"
			end
			c.distL.TextColor3 = colorFor(p, d)
		end
	elseif c.tag then
		c.tag:Destroy()
		c.tag, c.nameL, c.distL = nil, nil, nil
	end

	-- TRACER (kabel penunjuk lokasi)
	local t = F.Tracer
	if t.On then
		if not c.line then
			local line = Instance.new("Frame")
			line.Name = "SQ_Line"
			line.AnchorPoint = Vector2.new(0.5, 0.5)
			line.BorderSizePixel = 0
			line.Parent = tracerGui
			c.line = line
		end
		if visible(t) then
			local v = cam:WorldToViewportPoint(root.Position)
			local size = cam.ViewportSize
			local pt = Vector2.new(v.X, v.Y)
			if v.Z < 0 then
				pt = Vector2.new(size.X - pt.X, size.Y - pt.Y)
			end
			local oy = t.Origin == "Bawah" and size.Y or (t.Origin == "Tengah" and size.Y / 2 or 0)
			local o = Vector2.new(size.X / 2, oy)
			local diff = pt - o
			c.line.Size = UDim2.fromOffset(math.min(diff.Magnitude, 4000), t.Thick)
			c.line.Position = UDim2.fromOffset((o.X + pt.X) / 2, (o.Y + pt.Y) / 2)
			c.line.Rotation = math.deg(math.atan2(diff.Y, diff.X))
			c.line.BackgroundColor3 = colorFor(p, t)
			c.line.Visible = true
		else
			c.line.Visible = false
		end
	elseif c.line then
		c.line:Destroy()
		c.line = nil
	end
end

RunService.RenderStepped:Connect(function()
	local cam = workspace.CurrentCamera
	for _, p in Players:GetPlayers() do
		if p ~= lp then
			update(p, cam)
		end
	end
end)
Players.PlayerRemoving:Connect(drop)

---------------------------------------------------------------- UI HELPERS
local ON, OFF = Color3.fromRGB(46, 160, 90), Color3.fromRGB(58, 58, 74)
local BG, PANEL = Color3.fromRGB(22, 22, 30), Color3.fromRGB(32, 32, 44)
local W = Color3.new(1, 1, 1)

local order = 0
local function nextOrder()
	order += 1
	return order
end

local function new(class, props, parent)
	local o = Instance.new(class)
	for k, v in props do o[k] = v end
	o.Parent = parent
	return o
end

local function corner(o, r)
	new("UICorner", { CornerRadius = UDim.new(0, r or 6) }, o)
end

local function pad(o, n)
	new("UIPadding", {
		PaddingTop = UDim.new(0, n), PaddingBottom = UDim.new(0, n),
		PaddingLeft = UDim.new(0, n), PaddingRight = UDim.new(0, n),
	}, o)
end

local function list(o, gap)
	new("UIListLayout", { Padding = UDim.new(0, gap), SortOrder = Enum.SortOrder.LayoutOrder }, o)
end

local function mkToggle(parent, size, label, init, cb, pos)
	local on = init
	local b = new("TextButton", {
		Size = size, Position = pos or UDim2.new(), LayoutOrder = nextOrder(), AutoButtonColor = false,
		Text = "", TextColor3 = W, Font = Enum.Font.GothamMedium, TextSize = 14, BackgroundColor3 = OFF,
	}, parent)
	corner(b)
	local function render()
		b.BackgroundColor3 = on and ON or OFF
		b.Text = label .. " : " .. (on and "On" or "Off")
	end
	render()
	b.MouseButton1Click:Connect(function()
		on = not on
		render()
		cb(on)
	end)
	return b, function(v) on = v; render() end
end

local function mkCycle(parent, size, label, opts, init, cb)
	local idx = table.find(opts, init) or 1
	local b = new("TextButton", {
		Size = size, LayoutOrder = nextOrder(), AutoButtonColor = false, BackgroundColor3 = OFF,
		TextColor3 = W, Font = Enum.Font.GothamMedium, TextSize = 14,
		Text = label .. " : " .. tostring(opts[idx]),
	}, parent)
	corner(b)
	b.MouseButton1Click:Connect(function()
		idx = idx % #opts + 1
		b.Text = label .. " : " .. tostring(opts[idx])
		cb(opts[idx])
	end)
end

local function draggable(handle, target, onClick)
	local dragging, startMouse, startPos, moved = false, nil, nil, 0
	handle.InputBegan:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
			dragging, moved = true, 0
			startMouse, startPos = i.Position, target.Position
			i.Changed:Connect(function()
				if i.UserInputState == Enum.UserInputState.End then
					if dragging and onClick and moved < 6 then onClick() end
					dragging = false
				end
			end)
		end
	end)
	UIS.InputChanged:Connect(function(i)
		if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
			local d = i.Position - startMouse
			moved = math.max(moved, d.Magnitude)
			target.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
		end
	end)
end

