back.MouseButton1Click:Connect(function() showPage("Home") end)

local rows = {
	{ "Esp", "Esp" }, { "Name", "Esp Nama" }, { "Dist", "Esp Jarak" }, { "Tracer", "Tracer" },
}
for _, r in rows do
	local key, label = r[1], r[2]
