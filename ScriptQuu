local GROUPS = {
	Head = { "Head" },
	Torso = { "Torso", "UpperTorso", "LowerTorso" },
	Arms = { "Left Arm", "Right Arm", "LeftUpperArm", "LeftLowerArm", "LeftHand", "RightUpperArm", "RightLowerArm", "RightHand" },
	Legs = { "Left Leg", "Right Leg", "LeftUpperLeg", "LeftLowerLeg", "LeftFoot", "RightUpperLeg", "RightLowerLeg", "RightFoot" },
}

local function wanted(partName)
	if E.Parts.Full then
		return partName ~= "HumanoidRootPart"
	end
	for group, on in E.Parts do
		if on and group ~= "Full" and table.find(GROUPS[group], partName) then
			return true
		end
	end
	return false
end

---------------------------------------------------------------- ESP CORE
local cache = {}
local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude

local function isVisible(char, target, cam)
	local filter = { char }
	if lp.Character then table.insert(filter, lp.Character) end
	rayParams.FilterDescendantsInstances = filter
	local origin = cam.CFrame.Position
	return workspace:Raycast(origin, target.Position - origin, rayParams) == nil
end

local function drop(p)
	local c = cache[p]
	if not c then return end
	if c.sel then c.sel:Destroy() end
	if c.tag then c.tag:Destroy() end
	if c.line then c.line:Destroy() end
	if c.boxes then
		for _, b in c.boxes do b:Destroy() end
	end
	cache[p] = nil
end

local tracerGui = Instance.new("ScreenGui")
tracerGui.Name = "SQ_Tracer"
tracerGui.ResetOnSpawn = false
tracerGui.IgnoreGuiInset = true
tracerGui.Parent = lp:WaitForChild("PlayerGui")

local function mkLabel(parent, y)
	local l = Instance.new("TextLabel")
	l.Size = UDim2.new(1, 0, 0, 18)
	l.Position = UDim2.fromOffset(0, y)
	l.BackgroundTransparency = 1
	l.Font = Enum.Font.GothamBold
	l.TextSize = 14
	l.TextStrokeTransparency = 0.3
	l.Text = ""
	l.Parent = parent
	return l
end

local function update(p, cam)
	local char = p.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local root = char and char:FindFirstChild("HumanoidRootPart")
	local head = char and char:FindFirstChild("Head")

	if not E.On or not hum or hum.Health <= 0 or not root or not head then
		drop(p)
		return
	end

	local c = cache[p]
	if c and c.char ~= char then
		drop(p)
		c = nil
	end
	if not c then
		c = { char = char, boxes = {} }
		cache[p] = c
	end

	local vis
	local function visible(check)
		if not check then return true end
		if vis == nil then
			vis = isVisible(char, root, cam) or isVisible(char, head, cam)
		end
		return vis
	end

	local col = (E.TeamColor and p.Team) and p.Team.TeamColor.Color or E.Color
	local show = visible(E.WallCheck)

	-- BADAN (satu kotak utuh)
	if E.Body then
		if not c.sel or not c.sel.Parent then
			local s = Instance.new("SelectionBox")
			s.Name = "SQ_Body"
			s.Adornee = char
			s.LineThickness = 0.04
			s.Parent = char
			c.sel = s
		end
		c.sel.Color3 = col
		c.sel.SurfaceColor3 = col
		c.sel.SurfaceTransparency = E.Fill and 0.8 or 1
		c.sel.Visible = show
	elseif c.sel then
		c.sel:Destroy()
		c.sel = nil
	end

	-- PART
	for part, box in c.boxes do
		if not part.Parent or not E.Part or not wanted(part.Name) then
			box:Destroy()
			c.boxes[part] = nil
		end
	end
	if E.Part then
		for _, part in char:GetChildren() do
			if part:IsA("BasePart") and wanted(part.Name) and not c.boxes[part] then
				local box = Instance.new("BoxHandleAdornment")
				box.Name = "SQ_Part"
				box.Adornee = part
				box.Size = part.Size
				box.Transparency = 0.45
				box.ZIndex = 1
				box.AlwaysOnTop = true
				box.Parent = part
				c.boxes[part] = box
			end
		end
		for _, box in c.boxes do
			box.Color3 = col
			box.Visible = show
		end
	end

	-- NAMA + JARAK
	if E.Name or E.Dist then
		if not c.tag or not c.tag.Parent then
			local tag = Instance.new("BillboardGui")
			tag.Name = "SQ_Tag"
			tag.Size = UDim2.fromOffset(160, 36)
			tag.StudsOffset = Vector3.new(0, 3, 0)
			tag.AlwaysOnTop = true
			tag.Adornee = head
			c.nameL = mkLabel(tag, 0)
			c.distL = mkLabel(tag, 18)
			tag.Parent = head
			c.tag = tag
		end
		c.nameL.Visible = E.Name and show
		if E.Name then
			c.nameL.Text = E.Display and p.DisplayName or p.Name
			c.nameL.TextColor3 = col
		end
		c.distL.Position = UDim2.fromOffset(0, E.Name and 18 or 9)
		c.distL.Visible = E.Dist and show
		if E.Dist then
			local lroot = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
			local from = lroot and lroot.Position or cam.CFrame.Position
			local studs = (root.Position - from).Magnitude
			if E.Unit == "Meter" then
				c.distL.Text = math.floor(studs * STUD_TO_M) .. "m"
			else
				c.distL.Text = math.floor(studs) .. " stud"
			end
			c.distL.TextColor3 = col
		end
	elseif c.tag then
		c.tag:Destroy()
		c.tag, c.nameL, c.distL = nil, nil, nil
	end

	-- TRACER (kabel penunjuk lokasi)
	if E.Tracer then
		if not c.line then
			local line = Instance.new("Frame")
			line.Name = "SQ_Line"
			line.AnchorPoint = Vector2.new(0.5, 0.5)
			line.BorderSizePixel = 0
			line.Parent = tracerGui
			c.line = line
		end
		if visible(E.TracerWall) then
			local v = cam:WorldToViewportPoint(root.Position)
			local size = cam.ViewportSize
			local pt = Vector2.new(v.X, v.Y)
			if v.Z < 0 then
				pt = Vector2.new(size.X - pt.X, size.Y - pt.Y)
			end
			local oy = E.Origin == "Bawah" and size.Y or (E.Origin == "Tengah" and size.Y / 2 or 0)
			local o = Vector2.new(size.X / 2, oy)
			local diff = pt - o
			c.line.Size = UDim2.fromOffset(math.min(diff.Magnitude, 4000), E.Thick)
			c.line.Position = UDim2.fromOffset((o.X + pt.X) / 2, (o.Y + pt.Y) / 2)
			c.line.Rotation = math.deg(math.atan2(diff.Y, diff.X))
			c.line.BackgroundColor3 = col
			c.line.Visible = true
		else
			c.line.Visible = false
		end
	elseif c.line then
		c.line:Destroy()
		c.line = nil
	end
end

RunService.RenderStepped:Connect(function()
	local cam = workspace.CurrentCamera
	for _, p in Players:GetPlayers() do
		if p ~= lp then
			update(p, cam)
		end
	end
end)
