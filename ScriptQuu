---------------------------------------------------------------- FLY
local flyConn
local function startFly()
	local char = lp.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not root or not hum then return end
	hum.PlatformStand = true
	local bv = Instance.new("BodyVelocity")
	bv.Name = "SQ_Fly"
	bv.MaxForce = Vector3.new(1e9, 1e9, 1e9)
	bv.Velocity = Vector3.new()
	bv.Parent = root
	flyConn = RunService.RenderStepped:Connect(function()
		if not X.Fly then return end
		local c2 = workspace.CurrentCamera
		local move = Vector3.new()
		if UIS:IsKeyDown(Enum.KeyCode.W) then move += c2.CFrame.LookVector end
		if UIS:IsKeyDown(Enum.KeyCode.S) then move -= c2.CFrame.LookVector end
		if UIS:IsKeyDown(Enum.KeyCode.A) then move -= c2.CFrame.RightVector end
		if UIS:IsKeyDown(Enum.KeyCode.D) then move += c2.CFrame.RightVector end
		if UIS:IsKeyDown(Enum.KeyCode.Space) then move += Vector3.new(0, 1, 0) end
		if UIS:IsKeyDown(Enum.KeyCode.LeftControl) then move -= Vector3.new(0, 1, 0) end
		if move.Magnitude > 0 then move = move.Unit end
		bv.Velocity = move * X.FlySpeed
	end)
end
local function stopFly()
	if flyConn then flyConn:Disconnect(); flyConn = nil end
