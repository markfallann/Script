-- SETTINGS (tersimpan permanen)
local cfg = {esp=false, name=false, dist=false, full=false, hitbox=false, walls=false, tracker=false, sound=false}
pcall(function()
	if readfile and isfile and isfile(FILE) then
		local d = HttpService:JSONDecode(readfile(FILE))
		for k, v in pairs(d) do
			if cfg[k] ~= nil then cfg[k] = v end
		end
	end
end)
local function save()
	pcall(function()
		if writefile then writefile(FILE, HttpService:JSONEncode(cfg)) end
	end)
end

