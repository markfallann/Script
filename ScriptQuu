local refreshers = {}
local function refreshAll() for _, f in ipairs(refreshers) do f() end end

local function makeRow(parent, label, key, withGear)
	local r = new("Frame", {Size = UDim2.new(1, -6, 0, 34), BackgroundColor3 = ROW, BorderSizePixel = 0}, parent)
	round(r, 6)
	local b = new("TextButton", {
		Size = UDim2.new(1, withGear and -36 or 0, 1, 0), BackgroundTransparency = 1, Text = label, TextColor3 = DIM,
		Font = Enum.Font.GothamMedium, TextSize = 13, TextXAlignment = Enum.TextXAlignment.Left,
	}, r)
	new("UIPadding", {PaddingLeft = UDim.new(0, 10)}, b)
	local dot = new("Frame", {Size = UDim2.new(0, 8, 0, 8), AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -8, 0.5, 0), BackgroundColor3 = Color3.fromRGB(70, 70, 70)}, b)
	round(dot, 4)
	local function refresh()
		local on = cfg[key]
		dot.BackgroundColor3 = on and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(70, 70, 70)
		b.TextColor3 = on and TXT or DIM
	end
	table.insert(refreshers, refresh)
	b.Activated:Connect(function()
		cfg[key] = not cfg[key]
		refresh()
		save()
	end)
	if withGear then
		local g = new("TextButton", {Position = UDim2.new(1, -34, 0, 2), Size = UDim2.new(0, 30, 0, 30), BackgroundTransparency = 1, Text = "⚙️", TextColor3 = TXT, TextSize = 16, Font = Enum.Font.Gotham}, r)
		g.Activated:Connect(function() sp.Visible = not sp.Visible end)
	end
	refresh()
end

