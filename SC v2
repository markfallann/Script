-- ===== UI BUILDER =====
local function makeUI(body, state)
	local U, order = {}, 0
	function U.row(h)
		order += 1
		local f = new("TextButton", {
			Size = UDim2.new(1, -12, 0, h or 28), LayoutOrder = order, BackgroundColor3 = C_BTN,
			TextColor3 = WHITE, Font = Enum.Font.Gotham, TextSize = 13, Text = "",
		}, body)
		corner(f, 6)
		return f
	end
	function U.tg(label, key, cb)
		local b = U.row()
		local function paint()
			local v = state[key]
			b.Text = label .. ": " .. (v and "ON" or "OFF")
			b.BackgroundColor3 = v and C_ON or C_BTN
		end
		local function setV(v)
			state[key] = v
			paint()
			if cb then cb(v) end
		end
		on(b.MouseButton1Click, function() setV(not state[key]) end)
		paint()
		return setV
	end
	function U.num(hint, key, lo, hi)
		local r = U.row()
		local t = new("TextBox", {
			Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, Text = "",
			PlaceholderText = hint .. ": " .. tostring(state[key]), TextColor3 = WHITE,
			Font = Enum.Font.Gotham, TextSize = 13,
		}, r)
		on(t.FocusLost, function()
			local n = tonumber(t.Text)
			if n then state[key] = math.clamp(n, lo, hi) end
			t.PlaceholderText = hint .. ": " .. tostring(state[key])
			t.Text = ""
		end)
	end
	function U.btn(text, fn)
		local b = U.row()
		b.Text = text
		on(b.MouseButton1Click, fn)
		return b
	end
	function U.sep(text)
		local b = U.row(22)
		b.Text = text
		b.AutoButtonColor = false
		b.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
		b.TextColor3 = Color3.fromRGB(150, 150, 150)
		return b
	end
	return U
end

