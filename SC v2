local FILE = "MarkMenu.json"
local skip = {Fly = true, Spectate = true, ClickTP = true}
local function saveCfg()
	if not writefile then return end
	local t = {}
	for k, v in pairs(S) do
		if not skip[k] and (type(v) == "boolean" or type(v) == "number") then t[k] = v end
	end
	pcall(function() writefile(FILE, HttpService:JSONEncode(t)) end)
end
local function loadCfg()
	if not (isfile and readfile) then return end
	pcall(function()
		if not isfile(FILE) then return end
		local t = HttpService:JSONDecode(readfile(FILE))
		if type(t) ~= "table" then return end
		for k, v in pairs(t) do
			if S[k] ~= nil and type(S[k]) == type(v) and not skip[k] then S[k] = v end
		end
	end)
end
