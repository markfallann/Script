local function doClick(x, y)
	local ok = okV and pcall(function()
		VIM:SendMouseButtonEvent(x, y, 0, true, game, 0)
		task.wait(0.03)
		VIM:SendMouseButtonEvent(x, y, 0, false, game, 0)
	end)
	if not ok and mousemoveabs and mouse1click then
		pcall(function() mousemoveabs(x, y) mouse1click() end)
	end
end

local function startClick()
	acToken += 1
	local my = acToken
	task.spawn(function()
		while S2.ClickOn and acToken == my and #points > 0 do
			for _, m in ipairs(points) do
				if not (S2.ClickOn and acToken == my) then break end
				if m.Parent then
					local c = m.AbsolutePosition + m.AbsoluteSize / 2
					doClick(c.X, c.Y)
				end
				task.wait(math.max(S2.ClickDelay, 0.02))
			end
			if not S2.ClickLoop then break end
		end
		if acToken == my and S2.ClickOn then R.Click(false) end
	end)
end

