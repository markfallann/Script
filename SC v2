-- ESP
local cache = {}
local function clear(p)
	local c = cache[p]
	if c then for _, o in ipairs(c.objs) do o:Destroy() end cache[p] = nil end
end

local function build(p, char)
	clear(p)
	local objs = {}
	local hl = Instance.new("Highlight")
	hl.Adornee = char
	hl.FillTransparency = 0.5
	hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	hl.Parent = espFolder
	table.insert(objs, hl)

	local head = char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")
	local bb = Instance.new("BillboardGui")
	bb.Adornee = head
	bb.Size = UDim2.new(0,120,0,20)
	bb.StudsOffset = Vector3.new(0,2.5,0)
	bb.AlwaysOnTop = true
	bb.Parent = espFolder
	table.insert(objs, bb)
	local tl = Instance.new("TextLabel", bb)
	tl.Size = UDim2.new(1,0,1,0)
	tl.BackgroundTransparency = 1
	tl.Font = Enum.Font.GothamBold
	tl.TextSize = 14
	tl.TextStrokeTransparency = 0
	tl.Text = p.DisplayName

	local boxes = {}
	for _, part in ipairs(char:GetChildren()) do
		if part:IsA("BasePart") then
			local b = Instance.new("BoxHandleAdornment")
			b.Adornee = part
			b.Size = part.Size
			b.AlwaysOnTop = true
			b.ZIndex = 5
			b.Transparency = 0.5
			b.Parent = espFolder
			table.insert(objs, b)
			table.insert(boxes, b)
		end
	end
	cache[p] = {char=char, hl=hl, bb=bb, tl=tl, boxes=boxes, objs=objs}
end

local acc = 0
RunService.Heartbeat:Connect(function(dt)
	acc += dt
	if acc < 0.15 then return end
	acc = 0
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= lp then
			local char = p.Character
			if char and char.Parent then
				local c = cache[p]
				if not c or c.char ~= char then build(p, char); c = cache[p] end
				local col = teamColor(p)
				c.hl.Enabled = S.Player
				c.hl.FillColor = col
				c.hl.OutlineColor = col
				c.bb.Enabled = S.Name
				c.tl.TextColor3 = col
				c.tl.Text = p.DisplayName .. " [" .. (p.Team and p.Team.Name or "No Team") .. "]"
				for _, b in ipairs(c.boxes) do
					b.Visible = S.Part
					b.Color3 = col
				end
			else
				clear(p)
			end
		end
	end
end)
Players.PlayerRemoving:Connect(clear)

-- noclip + speed
RunService.Stepped:Connect(function()
	local char = lp.Character
	if not char then return end
	if S.Noclip then
		for _, v in ipairs(char:GetDescendants()) do
			if v:IsA("BasePart") then v.CanCollide = false end
		end
	end
	local hum = char:FindFirstChildOfClass("Humanoid")
	if hum then
		if S.Speed then hum.WalkSpeed = S.SpeedVal
		elseif hum.WalkSpeed == S.SpeedVal and S.SpeedVal ~= 16 then hum.WalkSpeed = 16 end
	end
end)

-- auto aim
local function getAimPart(char)
	local want = AimParts[S.AimIdx]
	if want == "Torso" then
		return char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")
	end
	return char:FindFirstChild(want)
end

RunService.RenderStepped:Connect(function()
	if not S.Aim then return end
	local center = Vector2.new(cam.ViewportSize.X/2, cam.ViewportSize.Y/2)
	local best, bestDist
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= lp and p.Character and not (S.TeamCheck and p.Team and p.Team == lp.Team) then
			local hum = p.Character:FindFirstChildOfClass("Humanoid")
			local part = getAimPart(p.Character)
			if hum and hum.Health > 0 and part then
				local pos, on = cam:WorldToViewportPoint(part.Position)
				if on then
					local d = (Vector2.new(pos.X, pos.Y) - center).Magnitude
					if not bestDist or d < bestDist then best, bestDist = part, d end
				end
			end
		end
	end
	if best then
		cam.CFrame = CFrame.lookAt(cam.CFrame.Position, best.Position)
	end
end)
