local arrowGui = new("ScreenGui", { Name = "SQ_Arrow", ResetOnSpawn = false }, lp.PlayerGui)
local arrowCache = {}

RunService.RenderStepped:Connect(function()
	if not E.On then
		for _, a in arrowCache do a:Destroy() end
		table.clear(arrowCache)
		return
	end
	local cam2 = workspace.CurrentCamera
	local size = cam2.ViewportSize
	local center = Vector2.new(size.X / 2, size.Y / 2)
	for _, p in Players:GetPlayers() do
		if p ~= lp then
			local oc = p.Character
			local root = oc and oc:FindFirstChild("HumanoidRootPart")
			local hum = oc and oc:FindFirstChildOfClass("Humanoid")
			if root and hum and hum.Health > 0 then
				local v = cam2:WorldToViewportPoint(root.Position)
				local onScreen = v.Z > 0 and v.X >= 0 and v.X <= size.X and v.Y >= 0 and v.Y <= size.Y
				if not onScreen then
					if not arrowCache[p] then
						local a = new("TextLabel", {
							Size = UDim2.fromOffset(22, 22), BackgroundTransparency = 1, Text = "➤",
							TextColor3 = Color3.fromRGB(255, 80, 80), Font = Enum.Font.GothamBold, TextSize = 20,
							AnchorPoint = Vector2.new(0.5, 0.5),
						}, arrowGui)
						arrowCache[p] = a
					end
					local dir = Vector2.new(v.X, v.Y) - center
					if v.Z < 0 then dir = -dir end
					dir = dir.Magnitude > 0 and dir.Unit or Vector2.new(1, 0)
					local margin = 40
					local radius = math.min(size.X, size.Y) / 2 - margin
					local pos = center + dir * radius
					arrowCache[p].Position = UDim2.fromOffset(pos.X, pos.Y)
					arrowCache[p].Rotation = math.deg(math.atan2(dir.Y, dir.X)) + 90
				elseif arrowCache[p] then
					arrowCache[p]:Destroy()
					arrowCache[p] = nil
				end
			end
		end
	end
end)

