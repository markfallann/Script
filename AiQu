	round(f, 10)
	local g = Instance.new("UIGradient")
	g.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.fromRGB(60, 60, 70)),
		ColorSequenceKeypoint.new(0.5, Color3.fromRGB(110, 110, 125)),
		ColorSequenceKeypoint.new(1, Color3.fromRGB(60, 60, 70)),
	})
	g.Offset = Vector2.new(-1, 0)
	g.Parent = f
	local tw = TS:Create(g, TweenInfo.new(1.5, Enum.EasingStyle.Linear, Enum.EasingDirection.In, -1), {Offset = Vector2.new(1, 0)})
	tw:Play()
	toBottom()
	return f, tw
end

-- Lapisan 2: HTTP
local function chat(messages, maxTokens)
	local ok, res = pcall(function()
		return HttpService:RequestAsync({
			Url = URL,
			Method = "POST",
			Headers = {
				["Content-Type"] = "application/json",
				["Authorization"] = "Bearer " .. API_KEY,
			},
			Body = HttpService:JSONEncode({
				model = MODEL,
				messages = messages,
				max_tokens = maxTokens,
				reasoning_effort = "low",
			}),
		})
	end)
	if not ok then return nil, tostring(res) end
	if not res.Success then return nil, "HTTP " .. res.StatusCode end
	local data = HttpService:JSONDecode(res.Body)
	local c = data.choices and data.choices[1]
	if not c then return nil, "respon kosong" end
	return c.message.content or "", c.finish_reason
end

local function withSkeleton(messages, maxTokens)
	local sk, tw = addSkeleton()
	local a, b = chat(messages, maxTokens)
	tw:Cancel()
	sk:Destroy()
	return a, b
end

-- Lapisan 3: Builder
local function getFolder()
	local f = workspace:FindFirstChild("AIBuild")
	if not f then
		f = Instance.new("Folder")
		f.Name = "AIBuild"
		f.Parent = workspace
	end
	return f
end

local function build(cmds)
	local folder = getFolder()
	local made = 0
	for i, c in ipairs(cmds) do
		if i > 200 then break end
		if type(c) == "table" then
			if c.cmd == "part" then
				local p = Instance.new("Part")
				p.Name = tostring(c.name or "Part")
				p.Anchored = c.anchored ~= false
				p.Size = Vector3.new(unpack(c.size or {4, 1, 2}))
				p.Position = Vector3.new(unpack(c.pos or {0, 5, 0}))
				p.Color = Color3.fromRGB(unpack(c.color or {163, 162, 165}))
				p.Transparency = tonumber(c.transparency) or 0
				pcall(function() p.Material = Enum.Material[c.material] end)
				pcall(function() p.Shape = Enum.PartType[c.shape] end)
				p.Parent = folder
				made += 1
			elseif c.cmd == "delete" then
				local t = folder:FindFirstChild(tostring(c.name))
				if t then t:Destroy() end
			end
		end
	end
	return made
end

local function runBuild(text)
	local raw = text:match("<build>(.-)</build>")
	if not raw then return end
	raw = raw:gsub("```%a*", ""):gsub("```", "")
	local ok, cmds = pcall(function()
		return HttpService:JSONDecode(raw)
	end)
	if not ok or type(cmds) ~= "table" then
		addBubble("Build gagal dibaca.", false)
		return
	end
	if cmds.cmd then cmds = {cmds} end
	local made = build(cmds)
	addBubble("Dibuat: " .. made .. " part (folder AIBuild di Workspace)", false)
end

