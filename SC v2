end

UIS.InputBegan:Connect(function(i, gp)
	if gp then return end
	if S2.Pick and i.UserInputType == Enum.UserInputType.MouseButton1 and mouse2.Target then
		addWP(mouse2.Hit.Position)
	end
end)
UIS.TouchTapInWorld:Connect(function(_, gp)
	if not gp and S2.Pick and mouse2.Target then addWP(mouse2.Hit.Position) end
end)

RunService.Heartbeat:Connect(function(dt)
	if not S2.Slide then return end
	if #wps == 0 then R.Slide(false) return end
	local root = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
	local target = wps[slideIdx]
	if not (root and target) then return end
	local tpos = target.Position + Vector3.new(0,1.5,0)
	local cur = root.Position
	local diff = tpos - cur
	local dist = diff.Magnitude
	local step = S2.SlideSpeed * dt
	local newPos = dist <= step and tpos or cur + diff.Unit * step
	local flat = Vector3.new(diff.X, 0, diff.Z)
	if flat.Magnitude > 0.05 then
		root.CFrame = CFrame.lookAt(newPos, newPos + flat)
	else
		root.CFrame = CFrame.new(newPos)
	end
	root.AssemblyLinearVelocity = Vector3.zero
	if dist <= step then
		slideIdx += 1
		if slideIdx > #wps then
			if S2.SlideLoop then slideIdx = 1 else R.Slide(false) end
		end
	end
end)

