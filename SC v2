	local function refresh()
		b.Text = label .. ": " .. (S[key] and "ON" or "OFF")
		b.BackgroundColor3 = S[key] and Color3.fromRGB(0,140,70) or Color3.fromRGB(45,45,45)
	end
	b.MouseButton1Click:Connect(function() S[key] = not S[key]; refresh() end)
	refresh()
end

