U1.tg("ESP Health+Jarak", "Health")

do
	local cache = {}
	local acc = 0

	local function kill(p)
		local e = cache[p]
		if e then
			for _, o in ipairs(e.objs) do pcall(function() o:Destroy() end) end
			cache[p] = nil
		end
	end

	local function build(p, char)
		kill(p)
		local head = char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")
		if not head then return nil end
		local e = {char = char, boxes = {}, objs = {}}
		local function add(o) e.objs[#e.objs + 1] = o return o end
		e.hl = add(new("Highlight", {Adornee = char, FillTransparency = 0.5, DepthMode = Enum.HighlightDepthMode.AlwaysOnTop}, espFolder))
		e.nbb = add(new("BillboardGui", {Adornee = head, Size = UDim2.new(0, 160, 0, 20), StudsOffset = Vector3.new(0, 2.5, 0), AlwaysOnTop = true}, espFolder))
		e.ntl = new("TextLabel", {Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, Font = Enum.Font.GothamBold, TextSize = 14, TextStrokeTransparency = 0, Text = ""}, e.nbb)
		e.hbb = add(new("BillboardGui", {Adornee = head, Size = UDim2.new(0, 90, 0, 26), StudsOffset = Vector3.new(0, 4.3, 0), AlwaysOnTop = true}, espFolder))
		local bg = new("Frame", {Size = UDim2.new(1, 0, 0, 5), BackgroundColor3 = Color3.new(0, 0, 0), BorderSizePixel = 0}, e.hbb)
		e.fill = new("Frame", {Size = UDim2.new(1, 0, 1, 0), BorderSizePixel = 0}, bg)
		e.htl = new("TextLabel", {Size = UDim2.new(1, 0, 0, 16), Position = UDim2.new(0, 0, 0, 7), BackgroundTransparency = 1, Font = Enum.Font.GothamBold, TextSize = 12, TextColor3 = WHITE, TextStrokeTransparency = 0, Text = ""}, e.hbb)
		for _, part in ipairs(char:GetChildren()) do
			if part:IsA("BasePart") then
				e.boxes[#e.boxes + 1] = add(new("BoxHandleAdornment", {Adornee = part, Size = part.Size, AlwaysOnTop = true, ZIndex = 5, Transparency = 0.5}, espFolder))
			end
		end
		e.line = add(new("Frame", {AnchorPoint = Vector2.new(0.5, 0.5), BorderSizePixel = 0, Visible = false}, ov))
		cache[p] = e
		return e
	end

	on(Players.PlayerRemoving, kill)

	on(RunService.RenderStepped, function(dt)
		acc += dt
		local slow = acc > 0.2
		if slow then acc = 0 end
		local vp = cam.ViewportSize
		local origin = Vector2.new(vp.X / 2, vp.Y)
		local myRoot = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
		for _, p in ipairs(Players:GetPlayers()) do
			if p ~= lp then
				local char = p.Character
				local hum = char and char:FindFirstChildOfClass("Humanoid")
				if char and char.Parent and hum then
					local e = cache[p]
					if not e or e.char ~= char then e = build(p, char) end
					if e then
						local col = teamColor(p)
						e.hl.Enabled = S.Player
						e.hl.FillColor = col
						e.hl.OutlineColor = col
						e.nbb.Enabled = S.Name
						e.ntl.TextColor3 = col
						for _, b in ipairs(e.boxes) do
							b.Visible = S.Part
							b.Color3 = col
						end
						e.hbb.Enabled = S.Health
						local root = char:FindFirstChild("HumanoidRootPart")
						if slow then
							e.ntl.Text = p.DisplayName .. " [" .. (p.Team and p.Team.Name or "No Team") .. "]"
							if S.Health then
								local dist = (root and myRoot) and math.floor((root.Position - myRoot.Position).Magnitude) or 0
								e.htl.Text = math.floor(hum.Health) .. " HP | " .. dist .. "m"
							end
						end
						if S.Health then
							local frac = math.clamp(hum.Health / math.max(hum.MaxHealth, 1), 0, 1)
							e.fill.Size = UDim2.new(frac, 0, 1, 0)
							e.fill.BackgroundColor3 = Color3.fromRGB(255, 0, 0):Lerp(Color3.fromRGB(0, 255, 0), frac)
						end
						local drawn = false
						if S.Tracer and root then
							local pos, onScreen = cam:WorldToViewportPoint(root.Position)
							if onScreen and pos.Z > 0 then
								local b = Vector2.new(pos.X, pos.Y)
								local d = b - origin
								e.line.Size = UDim2.new(0, d.Magnitude, 0, 1.5)
								e.line.Position = UDim2.new(0, (origin.X + b.X) / 2, 0, (origin.Y + b.Y) / 2)
								e.line.Rotation = math.deg(math.atan2(d.Y, d.X))
								e.line.BackgroundColor3 = col
								drawn = true
							end
						end
						e.line.Visible = drawn
					end
				elseif cache[p] then
					kill(p)
				end
			end
		end
	end)
end

