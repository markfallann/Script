-- skeleton shimmer
local shimmers = {}
local function skeleton(parent, n)
	for i = 1, n do
		local f = new("Frame", {Name = "Skel", Size = UDim2.new(1, -6, 0, 56), BackgroundColor3 = Color3.fromRGB(40, 40, 48), LayoutOrder = i}, parent)
		corner(f, 10)
		local g = new("UIGradient", {
			Color = ColorSequence.new({
				ColorSequenceKeypoint.new(0, Color3.fromRGB(40, 40, 48)),
				ColorSequenceKeypoint.new(0.5, Color3.fromRGB(70, 70, 82)),
				ColorSequenceKeypoint.new(1, Color3.fromRGB(40, 40, 48)),
			}),
		}, f)
		table.insert(shimmers, g)
	end
end
local t0 = os.clock()
RunService.RenderStepped:Connect(function()
	local x = ((os.clock() - t0) % 1.5) / 1.5 * 2 - 1
	for _, g in ipairs(shimmers) do if g.Parent then g.Offset = Vector2.new(x, 0) end end
end)

