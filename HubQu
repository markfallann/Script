-- HubQu (LocalScript)
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local UIS = game:GetService("UserInputService")
local HttpService = game:GetService("HttpService")
local RunService = game:GetService("RunService")

local lp = Players.LocalPlayer
local FILE = "HubQu.json"
local scripts = {}

-- storage
local hasFS = (writefile and readfile and isfile) and true or false
local function save()
	if hasFS then pcall(function() writefile(FILE, HttpService:JSONEncode(scripts)) end) end
end
local function load()
	if hasFS and isfile(FILE) then
		local ok, d = pcall(function() return HttpService:JSONDecode(readfile(FILE)) end)
		if ok and type(d) == "table" then scripts = d end
	end
end
load()

-- ui helpers
local function new(class, props, parent)
	local o = Instance.new(class)
	for k, v in pairs(props) do o[k] = v end
	if parent then o.Parent = parent end
	return o
end
local function corner(p, r) new("UICorner", {CornerRadius = UDim.new(0, r)}, p) end
local function stroke(p, t)
	return new("UIStroke", {Color = Color3.new(1, 1, 1), Transparency = t or 0.92, Thickness = 1}, p)
end
local function press(btn, base)
	local sc = new("UIScale", {Scale = 1}, btn)
	local info = TweenInfo.new(0.15, Enum.EasingStyle.Quad)
	local function tw(o, p) TweenService:Create(o, info, p):Play() end
	btn.MouseEnter:Connect(function() tw(btn, {BackgroundTransparency = math.max(base - 0.12, 0)}) end)
	btn.MouseLeave:Connect(function() tw(btn, {BackgroundTransparency = base}) tw(sc, {Scale = 1}) end)
	btn.MouseButton1Down:Connect(function() tw(sc, {Scale = 0.97}) end)
	btn.MouseButton1Up:Connect(function() tw(sc, {Scale = 1}) end)
end
local function button(text, parent, size, pos, base)
	base = base or 0.85
	local b = new("TextButton", {
		Text = text, Size = size, Position = pos or UDim2.new(),
		BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = base,
		TextColor3 = Color3.fromRGB(240, 240, 245), Font = Enum.Font.GothamMedium,
		TextSize = 13, AutoButtonColor = false,
	}, parent)
	corner(b, 8) stroke(b) press(b, base)
	return b
end

