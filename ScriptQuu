---------------------------------------------------------------- AUTO AIM
local AIM_PARTS = { "Head", "UpperTorso", "Torso", "LeftUpperArm", "RightUpperArm", "LeftUpperLeg", "RightUpperLeg" }

local function closestTarget()
	local char = lp.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if not root then return nil end
	local cam2 = workspace.CurrentCamera
	local best, bestDist
	for _, p in Players:GetPlayers() do
		if p ~= lp then
			local oc = p.Character
			local ohum = oc and oc:FindFirstChildOfClass("Humanoid")
			local opart = oc and oc:FindFirstChild(T.AimPart)
			if ohum and ohum.Health > 0 and opart then
				local v = cam2:WorldToViewportPoint(opart.Position)
				if v.Z > 0 then
					local screen = Vector2.new(v.X, v.Y)
					local center = Vector2.new(cam2.ViewportSize.X / 2, cam2.ViewportSize.Y / 2)
					local d = (screen - center).Magnitude
					if not bestDist or d < bestDist then
						bestDist, best = d, opart
					end
				end
			end
		end
	end
	return best
end

RunService.RenderStepped:Connect(function()
	if not T.Aim then return end
	local part = closestTarget()
	if part then
		local char = lp.Character
		local root = char and char:FindFirstChild("HumanoidRootPart")
		if root then
			workspace.CurrentCamera.CFrame = CFrame.new(workspace.CurrentCamera.CFrame.Position, part.Position)
		end
	end
end)

