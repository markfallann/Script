		g.Activated:Connect(function() panel.Visible = not panel.Visible end)
	end
	refresh()
end

local function stepRow(parent, label, key, step, mn, mx, onChange)
	local r = new("Frame", {Size = UDim2.new(1, -6, 0, 34), BackgroundColor3 = ROW, BorderSizePixel = 0}, parent)
	round(r, 6)
	local lbl = new("TextLabel", {Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, TextColor3 = TXT, Font = Enum.Font.GothamMedium, TextSize = 13}, r)
	local function refresh() lbl.Text = label .. ": " .. tostring(cfg[key]) end
	table.insert(refreshers, refresh)
	local function btn(txt, x, d)
		local b = new("TextButton", {Size = UDim2.new(0, 30, 0, 30), Position = UDim2.new(x, x == 0 and 2 or -32, 0, 2), BackgroundColor3 = Color3.fromRGB(40, 40, 40), Text = txt, TextColor3 = TXT, Font = Enum.Font.GothamBold, TextSize = 16, AutoButtonColor = false}, r)
		round(b, 6)
		b.Activated:Connect(function()
			cfg[key] = math.clamp(cfg[key] + d, mn, mx)
			refresh()
			save()
			if onChange then onChange() end
		end)
	end
	btn("-", 0, -step)
	btn("+", 1, step)
	refresh()
end

local function optRow(parent, items, key, onPick)
	local f = new("Frame", {Size = UDim2.new(1, -6, 0, 34), BackgroundTransparency = 1}, parent)
	new("UIListLayout", {FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 4)}, f)
	for _, it in ipairs(items) do
		local b = new("TextButton", {Size = UDim2.new(1 / #items, -4, 1, 0), BackgroundColor3 = ROW, Text = it[2], Font = Enum.Font.GothamMedium, TextSize = 12, TextColor3 = DIM, AutoButtonColor = false}, f)
		round(b, 6)
		local function refresh()
			local s = cfg[key] == it[1]
			b.TextColor3 = s and TXT or DIM
			b.BackgroundColor3 = s and Color3.fromRGB(40, 40, 40) or ROW
		end
		table.insert(refreshers, refresh)
		b.Activated:Connect(function()
			cfg[key] = it[1]
			refreshAll()
			save()
			if onPick then onPick() end
		end)
		refresh()
	end
end

