U1.tg("FOV Circle", "ShowFOV")
U1.num("Radius FOV", "AimRadius", 20, 800)
U1.num("Smooth 0.01-1", "Smooth", 0.01, 1)
U1.tg("Wall Check", "WallCheck")

do
	local circle = new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0.5, 0),
		BackgroundTransparency = 1, Visible = false,
	}, ov)
	corner(circle, 0, 1)
	new("UIStroke", {Thickness = 1.5, Color = WHITE}, circle)

	local rp = RaycastParams.new()
	rp.FilterType = Enum.RaycastFilterType.Exclude

	local function getPart(char)
		local want = AimParts[S.AimIdx]
		if want == "Torso" then
			return char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")
		end
		return char:FindFirstChild(want)
	end
	local function visible(part, char)
		local list = {char}
		if lp.Character then list[2] = lp.Character end
		rp.FilterDescendantsInstances = list
		return workspace:Raycast(cam.CFrame.Position, part.Position - cam.CFrame.Position, rp) == nil
	end

	on(RunService.RenderStepped, function()
		circle.Visible = S.ShowFOV
		circle.Size = UDim2.new(0, S.AimRadius * 2, 0, S.AimRadius * 2)
		if not S.Aim then return end
		local center = cam.ViewportSize / 2
		local best, bestD
		for _, p in ipairs(Players:GetPlayers()) do
			local char = p.Character
			if p ~= lp and char and not (S.TeamCheck and p.Team and p.Team == lp.Team) then
				local hum = char:FindFirstChildOfClass("Humanoid")
				local part = getPart(char)
				if hum and hum.Health > 0 and part then
					local pos, onScreen = cam:WorldToViewportPoint(part.Position)
					if onScreen then
						local d = (Vector2.new(pos.X, pos.Y) - center).Magnitude
						if d <= S.AimRadius and (not bestD or d < bestD) and (not S.WallCheck or visible(part, char)) then
							best, bestD = part, d
						end
					end
				end
			end
		end
		if best then
			cam.CFrame = cam.CFrame:Lerp(CFrame.lookAt(cam.CFrame.Position, best.Position), math.clamp(S.Smooth, 0.01, 1))
		end
	end)
end

