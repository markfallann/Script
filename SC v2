local function tracerStep()
	local vp = cam.ViewportSize
	local a = Vector2.new(vp.X/2, vp.Y)
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= lp then
			local root = p.Character and p.Character:FindFirstChild("HumanoidRootPart")
			if S.Tracer and root then
				local l = getLine(p)
				local pos, on = cam:WorldToViewportPoint(root.Position)
				if on then
					local b = Vector2.new(pos.X, pos.Y)
					local d = b - a
					l.Size = UDim2.new(0, d.Magnitude, 0, 1.5)
					l.Position = UDim2.new(0, (a.X+b.X)/2, 0, (a.Y+b.Y)/2)
					l.Rotation = math.deg(math.atan2(d.Y, d.X))
					l.BackgroundColor3 = teamColor(p)
					l.Visible = true
				else
					l.Visible = false
				end
			elseif lines[p] then
				lines[p].Visible = false
			end
		end
	end
end

local function healthStep()
	local myRoot = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= lp then
			local char = p.Character
			local hum = char and char:FindFirstChildOfClass("Humanoid")
			if S.Health and hum then
				local h = getHP(p, char)
				if h then
					local frac = math.clamp(hum.Health / math.max(hum.MaxHealth, 1), 0, 1)
					h.bb.Enabled = true
					h.fill.Size = UDim2.new(frac,0,1,0)
					h.fill.BackgroundColor3 = Color3.fromRGB(255,0,0):Lerp(Color3.fromRGB(0,255,0), frac)
					local root = char:FindFirstChild("HumanoidRootPart")
					local dist = (root and myRoot) and math.floor((root.Position - myRoot.Position).Magnitude) or 0
					h.tl.Text = math.floor(hum.Health) .. " HP | " .. dist .. "m"
				end
			elseif hp[p] then
				hp[p].bb.Enabled = false
			end
		end
	end
end

-- auto aim baru (fov circle + smooth + wall check)
local rp = RaycastParams.new()
rp.FilterType = Enum.RaycastFilterType.Exclude
local function visible(part, char)
	rp.FilterDescendantsInstances = {lp.Character, char}
	return workspace:Raycast(cam.CFrame.Position, part.Position - cam.CFrame.Position, rp) == nil
end

local function aimStep()
	if not S.Aim then return end
	local center = cam.ViewportSize / 2
	local best, bestD
	for _, p in ipairs(Players:GetPlayers()) do
		local char = p.Character
		if p ~= lp and char and not (S.TeamCheck and p.Team and p.Team == lp.Team) then
			local hum = char:FindFirstChildOfClass("Humanoid")
			local part = getAimPart(char)
			if hum and hum.Health > 0 and part then
				local pos, on = cam:WorldToViewportPoint(part.Position)
				if on then
					local d = (Vector2.new(pos.X, pos.Y) - center).Magnitude
					if d <= S.AimRadius and (not bestD or d < bestD) and (not S.WallCheck or visible(part, char)) then
						best, bestD = part, d
					end
				end
			end
		end
	end
	if best then
		cam.CFrame = cam.CFrame:Lerp(CFrame.lookAt(cam.CFrame.Position, best.Position), math.clamp(S.Smooth, 0.01, 1))
	end
end

