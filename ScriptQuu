-- ESP CORE
local folder = new("Folder", {Name = "SQ_ESP"}, cam)
local esp = {}
local rp = RaycastParams.new()
rp.FilterType = Enum.RaycastFilterType.Exclude

local beep = new("Sound", {SoundId = "rbxasset://sounds/electronicpingshort.wav", Volume = 1.5}, SoundService)

local function teamColor(p)
	return p.Team and p.Team.TeamColor.Color or Color3.fromRGB(255, 255, 255)
end

local function clear(p)
	local e = esp[p]
	if not e then return end
	for _, o in pairs({e.box, e.hl, e.bb, e.hit, e.alert, e.line}) do o:Destroy() end
	esp[p] = nil
end

local function build(p, ch, root)
	local head = ch:FindFirstChild("Head") or root
	local e = {char = ch, near = false, alertUntil = 0, lastHit = 0}
	e.box = new("BoxHandleAdornment", {Adornee = root, Size = Vector3.new(4, 5, 2), AlwaysOnTop = true, ZIndex = 1, Transparency = 0.6, Visible = false}, folder)
	e.hl = new("Highlight", {Adornee = ch, FillTransparency = 0.7, OutlineTransparency = 0, DepthMode = Enum.HighlightDepthMode.AlwaysOnTop, Enabled = false}, folder)
	e.alert = new("Highlight", {Adornee = ch, FillColor = Color3.fromRGB(255, 40, 40), OutlineColor = Color3.fromRGB(255, 255, 255), FillTransparency = 0.35, DepthMode = Enum.HighlightDepthMode.AlwaysOnTop, Enabled = false}, folder)
	e.hit = new("Folder", {}, folder)
	e.bb = new("BillboardGui", {Adornee = head, Size = UDim2.new(0, 200, 0, 34), StudsOffset = Vector3.new(0, 2.6, 0), AlwaysOnTop = true, Enabled = false}, gui)
	e.lbl = new("TextLabel", {Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, Font = Enum.Font.GothamMedium, TextSize = 13, TextStrokeTransparency = 0.4, TextColor3 = Color3.new(1, 1, 1)}, e.bb)
	e.line = new("Frame", {AnchorPoint = Vector2.new(0.5, 0.5), BorderSizePixel = 0, BackgroundTransparency = 0.4, Visible = false}, gui)
	esp[p] = e
	return e
end

local function hide(e)
	e.box.Visible = false
	e.hl.Enabled = false
	e.bb.Enabled = false
	e.hit:ClearAllChildren()
	e.line.Visible = false
	e.alert.Enabled = false
end

local function rebuildHit(e, ch, root, color)
	e.hit:ClearAllChildren()
	for _, part in ipairs(ch:GetChildren()) do
		if part:IsA("BasePart") and part ~= root then
			new("BoxHandleAdornment", {Adornee = part, Size = part.Size, Color3 = color, Transparency = 0.7, AlwaysOnTop = true, ZIndex = 1}, e.hit)
		elseif part:IsA("Tool") then
			for _, d in ipairs(part:GetDescendants()) do
				if d:IsA("BasePart") then
					new("BoxHandleAdornment", {Adornee = d, Size = d.Size, Color3 = Color3.fromRGB(255, 150, 0), Transparency = 0.4, AlwaysOnTop = true, ZIndex = 2}, e.hit)
				end
			end
		end
	end
	-- arah hadap
	new("BoxHandleAdornment", {Adornee = root, Size = Vector3.new(0.25, 0.25, 5), CFrame = CFrame.new(0, 0, -3.5), Color3 = Color3.fromRGB(255, 230, 0), Transparency = 0.2, AlwaysOnTop = true, ZIndex = 3}, e.hit)
end

local function canSee(ch, root)
	rp.FilterDescendantsInstances = {lp.Character, ch}
	local o = cam.CFrame.Position
	return Workspace:Raycast(o, root.Position - o, rp) == nil
end

RunService.RenderStepped:Connect(function()
	cam = Workspace.CurrentCamera
	local myChar = lp.Character
	local my = myChar and myChar:FindFirstChild("HumanoidRootPart")
	local now = os.clock()
	local vp = cam.ViewportSize

	for _, p in ipairs(Players:GetPlayers()) do
		if p == lp then continue end
		local ch = p.Character
		local root = ch and ch:FindFirstChild("HumanoidRootPart")
		local hum = ch and ch:FindFirstChildOfClass("Humanoid")
		local e = esp[p]

		if e and e.char ~= ch then clear(p) e = nil end

		if not cfg.esp or not root or not hum or hum.Health <= 0 or not my then
			if e then hide(e) end
			continue
		end
		if not e then e = build(p, ch, root) end

		local color = teamColor(p)
		local dist = (root.Position - my.Position).Magnitude
		local show = (not cfg.walls) or canSee(ch, root)

		-- body / full body
		e.box.Color3 = color
		e.hl.FillColor = color
		e.hl.OutlineColor = color
		e.box.Visible = show and not cfg.full
		e.hl.Enabled = show and cfg.full

		-- nama + jarak
		if show and (cfg.name or cfg.dist) then
			local t = {}
			if cfg.dist then table.insert(t, math.floor(dist) .. " stud") end
			if cfg.name then table.insert(t, "@" .. p.Name .. "(" .. (p.Team and p.Team.Name or "No Team") .. ")") end
			e.lbl.Text = table.concat(t, "\n")
			e.lbl.TextColor3 = color
			e.bb.Enabled = true
		else
			e.bb.Enabled = false
		end

		-- hitbox
		if show and cfg.hitbox then
			if now - e.lastHit > 0.3 then
				e.lastHit = now
				rebuildHit(e, ch, root, color)
			end
		else
			e.hit:ClearAllChildren()
		end

		-- tracker (garis jaring dari bawah layar)
		if cfg.tracker then
			local v = cam:WorldToViewportPoint(root.Position)
			if v.Z > 0 then
				local a, b = Vector2.new(vp.X / 2, vp.Y), Vector2.new(v.X, v.Y)
				local d = b - a
				e.line.Size = UDim2.new(0, d.Magnitude, 0, 1)
				e.line.Position = UDim2.new(0, (a.X + b.X) / 2, 0, (a.Y + b.Y) / 2)
				e.line.Rotation = math.deg(math.atan2(d.Y, d.X))
				e.line.BackgroundColor3 = color
				e.line.Visible = true
			else
				e.line.Visible = false
			end
		else
			e.line.Visible = false
		end

		-- sound + body (beda team mendekat)
		local enemy = p.Team ~= lp.Team or (p.Team == nil and lp.Team ~= nil)
		if cfg.sound and enemy and dist <= SOUND_RANGE then
			if not e.near then
				e.near = true
				beep:Play()
			end
			e.alertUntil = now + 2.5
		else
			e.near = false
		end
		e.alert.Enabled = cfg.sound and now < e.alertUntil
	end
end)

Players.PlayerRemoving:Connect(clear)
refreshAll()
