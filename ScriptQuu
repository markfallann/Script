		{ t = "color" }, { t = "toggle", k = "TeamColor", l = "Warna Team" },
		{ t = "toggle", k = "WallCheck", l = "Cek Tembok" }, { t = "toggle", k = "Fill", l = "Isi Badan" },
	} },
	Name = { title = "Setting Nama", items = {
		{ t = "color" }, { t = "toggle", k = "TeamColor", l = "Warna Team" },
		{ t = "toggle", k = "WallCheck", l = "Cek Tembok" }, { t = "toggle", k = "Display", l = "Display Name" },
	} },
	Dist = { title = "Setting Jarak", items = {
		{ t = "color" }, { t = "toggle", k = "TeamColor", l = "Warna Team" },
		{ t = "toggle", k = "WallCheck", l = "Cek Tembok" }, { t = "cycle", k = "Unit", l = "Satuan", o = { "Meter", "Stud" } },
	} },
	Tracer = { title = "Setting Tracer", items = {
		{ t = "color" }, { t = "toggle", k = "TeamColor", l = "Warna Team" },
		{ t = "toggle", k = "WallCheck", l = "Cek Tembok" },
		{ t = "cycle", k = "Origin", l = "Dari", o = { "Bawah", "Tengah", "Atas" } },
		{ t = "cycle", k = "Thick", l = "Tebal", o = { 1, 2, 3, 4 } },
	} },
}

local panels = {}

local function buildPanel(key, def)
	local cfg = F[key]
	local setters = {}
	local p = new("Frame", {
		Size = UDim2.fromOffset(226, 0), AutomaticSize = Enum.AutomaticSize.Y, AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(0, -8, 0, 0), BackgroundColor3 = PANEL, Visible = false,
	}, menu)
	corner(p, 10); pad(p, 8); list(p, 6)

	new("TextLabel", {
		Size = UDim2.new(1, 0, 0, 22), BackgroundTransparency = 1, Text = def.title, TextColor3 = W,
		Font = Enum.Font.GothamBold, TextSize = 14, LayoutOrder = nextOrder(),
	}, p)

	for _, it in def.items do
		if it.t == "color" then
			local grid = new("Frame", { Size = UDim2.new(1, 0, 0, 60), BackgroundTransparency = 1, LayoutOrder = nextOrder() }, p)
			new("UIGridLayout", { CellSize = UDim2.fromOffset(42, 26), CellPadding = UDim2.fromOffset(8, 8) }, grid)
			for _, col in palette do
				local sw = new("TextButton", { BackgroundColor3 = col, Text = "", AutoButtonColor = false }, grid)
				corner(sw)
				sw.MouseButton1Click:Connect(function()
					cfg.Color = col
					cfg.TeamColor = false
					if setters.TeamColor then setters.TeamColor(false) end
				end)
			end
		elseif it.t == "toggle" then
			local _, set = mkToggle(p, UDim2.new(1, 0, 0, 30), it.l, cfg[it.k], function(v) cfg[it.k] = v end)
			setters[it.k] = set
		elseif it.t == "cycle" then
			mkCycle(p, UDim2.new(1, 0, 0, 30), it.l, it.o, cfg[it.k], function(v) cfg[it.k] = v end)
		end
	end
	panels[key] = p
end

for key, def in DEFS do buildPanel(key, def) end

local function hidePanels()
	for _, p in panels do p.Visible = false end
end

---------------------------------------------------------------- PAGES
local function showPage(name)
	hidePanels()
	home.Visible = name == "Home"
	visual.Visible = name == "Visual"
	back.Visible = name ~= "Home"
	titleText.Text = name == "Home" and "ScriptQuu" or ("ScriptQuu  •  " .. name)
end

