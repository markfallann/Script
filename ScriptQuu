	local range = 150
	for _, p in Players:GetPlayers() do
		if p ~= lp then
			local oc = p.Character
			local oroot = oc and oc:FindFirstChild("HumanoidRootPart")
			if oroot then
				local rel = oroot.Position - root.Position
				local flat = Vector2.new(rel.X, rel.Z)
				if flat.Magnitude <= range then
					if not dots[p] then
						local d = new("Frame", { Size = UDim2.fromOffset(6, 6), BackgroundColor3 = Color3.fromRGB(255, 70, 70), AnchorPoint = Vector2.new(0.5, 0.5) }, radarFrame)
						corner(d, 3)
						dots[p] = d
					end
					local scaled = flat / range * 65
					dots[p].Position = UDim2.fromOffset(70 + scaled.X, 70 + scaled.Y)
					dots[p].Visible = true
				elseif dots[p] then
					dots[p].Visible = false
				end
			end
		end
	end
	for p, d in dots do
		if not p.Parent then d:Destroy(); dots[p] = nil end
	end
end)

---------------------------------------------------------------- FREECAM
local freecamConn
local savedCamType
local function startFreecam()
	local cam2 = workspace.CurrentCamera
	savedCamType = cam2.CameraType
	cam2.CameraType = Enum.CameraType.Scriptable
	freecamConn = RunService.RenderStepped:Connect(function()
		if not Tools.Freecam then return end
		local move = Vector3.new()
		if UIS:IsKeyDown(Enum.KeyCode.W) then move += cam2.CFrame.LookVector end
		if UIS:IsKeyDown(Enum.KeyCode.S) then move -= cam2.CFrame.LookVector end
		if UIS:IsKeyDown(Enum.KeyCode.A) then move -= cam2.CFrame.RightVector end
		if UIS:IsKeyDown(Enum.KeyCode.D) then move += cam2.CFrame.RightVector end
		if UIS:IsKeyDown(Enum.KeyCode.E) then move += Vector3.new(0, 1, 0) end
		if UIS:IsKeyDown(Enum.KeyCode.Q) then move -= Vector3.new(0, 1, 0) end
		if move.Magnitude > 0 then
			cam2.CFrame = cam2.CFrame + move.Unit * 1.5
		end
	end)
end
local function stopFreecam()
	if freecamConn then freecamConn:Disconnect(); freecamConn = nil end
	workspace.CurrentCamera.CameraType = savedCamType or Enum.CameraType.Custom
end
local lastFreecam = Tools.Freecam
RunService.Heartbeat:Connect(function()
	if Tools.Freecam ~= lastFreecam then
		lastFreecam = Tools.Freecam
		if Tools.Freecam then startFreecam() else stopFreecam() end
	end
end)

