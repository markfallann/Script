---------------------------------------------------------------- WALKFLING
RunService.Stepped:Connect(function()
	if not X.Fling then return end
	local char = lp.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not root or not hum then return end

	for _, p in Players:GetPlayers() do
		if p ~= lp then
			local oc = p.Character
			local oroot = oc and oc:FindFirstChild("HumanoidRootPart")
			local ohum = oc and oc:FindFirstChildOfClass("Humanoid")
			if oroot and ohum and ohum.Health > 0 then
				local dist = (oroot.Position - root.Position).Magnitude
				if dist <= X.FlingRange then
					local dir = (oroot.Position - root.Position)
					if dir.Magnitude < 0.1 then dir = Vector3.new(1, 0, 0) end
					dir = dir.Unit
					oroot.AssemblyLinearVelocity = dir * X.FlingPower + Vector3.new(0, X.FlingPower * 0.6, 0)
				end
			end
		end
	end
end)

