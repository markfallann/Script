		Size = UDim2.fromOffset(34, 32), Position = UDim2.new(1, -34, 0, 0), BackgroundColor3 = OFF,
		Text = "⚙️", TextSize = 16, AutoButtonColor = false,
	}, row)
	corner(gear)
	gear.MouseButton1Click:Connect(function()
		local show = not panels[key].Visible
		hidePanels()
		panels[key].Visible = show
	end)
end

