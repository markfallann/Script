-- list render
local function render()
	for _, c in ipairs(list:GetChildren()) do
		if c:IsA("GuiObject") then c:Destroy() end
	end
	local q = search.Text:lower()
	local n = 0
	for i, s in ipairs(scripts) do
		if q == "" or s.name:lower():find(q, 1, true) or s.author:lower():find(q, 1, true) then
			n += 1
			local card = new("TextButton", {
				Text = "", Size = UDim2.new(1, -6, 0, 56), LayoutOrder = i, AutoButtonColor = false,
				BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 0.93,
			}, list)
			corner(card, 10)
			local st = stroke(card, 0.92)
			local sc = new("UIScale", {Scale = 1}, card)
			new("TextLabel", {Text = s.name, Size = UDim2.new(1, -20, 0, 22), Position = UDim2.fromOffset(12, 8), BackgroundTransparency = 1, TextColor3 = Color3.new(1, 1, 1), Font = Enum.Font.GothamMedium, TextSize = 14, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd}, card)
			new("TextLabel", {Text = "oleh " .. s.author, Size = UDim2.new(1, -20, 0, 16), Position = UDim2.fromOffset(12, 31), BackgroundTransparency = 1, TextColor3 = Color3.fromRGB(150, 150, 162), Font = Enum.Font.Gotham, TextSize = 11, TextXAlignment = Enum.TextXAlignment.Left}, card)
			local info = TweenInfo.new(0.15, Enum.EasingStyle.Quad)
			card.MouseEnter:Connect(function() TweenService:Create(st, info, {Transparency = 0.7}):Play() TweenService:Create(sc, info, {Scale = 1.015}):Play() end)
			card.MouseLeave:Connect(function() TweenService:Create(st, info, {Transparency = 0.92}):Play() TweenService:Create(sc, info, {Scale = 1}):Play() end)
			card.MouseButton1Down:Connect(function() TweenService:Create(sc, info, {Scale = 0.99}):Play() end)
			card.MouseButton1Click:Connect(function()
				current = s
				dTitle.Text = s.name
				dAuthor.Text = "Pembuat: " .. s.author
				dDel.Visible = (s.author == lp.Name)
				dClose.Size = dDel.Visible and UDim2.new(0.5, -16, 0, 30) or UDim2.new(1, -24, 0, 30)
				dClose.Position = dDel.Visible and UDim2.new(0.5, 4, 0, 122) or UDim2.fromOffset(12, 122)
				detail.Visible = true
			end)
		end
	end
	if n == 0 then
		new("TextLabel", {Name = "Empty", Text = "Belum ada script", Size = UDim2.new(1, 0, 0, 40), BackgroundTransparency = 1, TextColor3 = Color3.fromRGB(130, 130, 142), Font = Enum.Font.Gotham, TextSize = 12}, list)
	end
end

local function openPanel()
	panel.Visible = true
	for _, c in ipairs(list:GetChildren()) do if c:IsA("GuiObject") then c:Destroy() end end
	skeleton(list, 4)
	task.delay(0.6, function()
		for i = #shimmers, 1, -1 do table.remove(shimmers, i) end
		render()
	end)
end

-- events
toggle.MouseButton1Click:Connect(function()
	if panel.Visible then panel.Visible = false detail.Visible = false addF.Visible = false else openPanel() end
end)
search:GetPropertyChangedSignal("Text"):Connect(render)
addBtn.MouseButton1Click:Connect(function() nameBox.Text = "" codeBox.Text = "" addF.Visible = true end)
cancelBtn.MouseButton1Click:Connect(function() addF.Visible = false end)
dClose.MouseButton1Click:Connect(function() detail.Visible = false end)

saveBtn.MouseButton1Click:Connect(function()
	if nameBox.Text:gsub("%s", "") == "" or codeBox.Text:gsub("%s", "") == "" then notify("Nama dan kode wajib diisi") return end
	table.insert(scripts, {name = nameBox.Text, author = lp.Name, code = codeBox.Text})
	save() render()
	addF.Visible = false
	notify("Tersimpan")
end)

dDel.MouseButton1Click:Connect(function()
	for i, s in ipairs(scripts) do if s == current then table.remove(scripts, i) break end end
	save() render()
	detail.Visible = false
	notify("Dihapus")
end)

dExec.MouseButton1Click:Connect(function()
	if not current then return end
	local ls = loadstring
	if not ls then notify("loadstring tidak tersedia") return end
	local fn, err = ls(current.code)
	if not fn then notify("Error: " .. tostring(err):sub(1, 40)) return end
	local ok, e = pcall(fn)
	notify(ok and "Executed" or ("Error: " .. tostring(e):sub(1, 40)))
	detail.Visible = false
end)

-- draggable toggle
do
	local dragging, startPos, startInput
	toggle.InputBegan:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
			dragging, startPos, startInput = true, toggle.Position, i.Position
			i.Changed:Connect(function() if i.UserInputState == Enum.UserInputState.End then dragging = false end end)
		end
	end)
	UIS.InputChanged:Connect(function(i)
		if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
			local d = i.Position - startInput
			toggle.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
			panel.Position = UDim2.new(toggle.Position.X.Scale, toggle.Position.X.Offset - 302, toggle.Position.Y.Scale, toggle.Position.Y.Offset + 46)
		end
	end)
end
