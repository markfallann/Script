	local _, set = mkToggle(panel, UDim2.fromOffset(10, 28 + (idx - 1) * 32), UDim2.fromOffset(200, 28), label, S.Parts[key], function(v)
		S.Parts[key] = v
		if v and key == "Full" then
			for k in S.Parts do
				if k ~= "Full" then
					S.Parts[k] = false
					setters[k](false)
				end
			end
		elseif v then
			S.Parts.Full = false
			setters.Full(false)
		end
	end)
	setters[key] = set
end

