-- warna per team: 1 putih, 2 merah, 3 biru, 4 hijau, dst
local palette = {
	Color3.fromRGB(255,255,255), Color3.fromRGB(255,0,0), Color3.fromRGB(0,100,255),
	Color3.fromRGB(0,255,0), Color3.fromRGB(255,255,0), Color3.fromRGB(255,128,0),
	Color3.fromRGB(170,0,255), Color3.fromRGB(0,255,255),
}
local function teamColor(p)
	if not p.Team then return palette[1] end
	for i, t in ipairs(Teams:GetTeams()) do
		if t == p.Team then return palette[((i - 1) % #palette) + 1] end
	end
	return palette[1]
end

