do
	local selected
	local selRow

	local function applySpectate()
		if S.Spectate and selected and selected.Character then
			local h = selected.Character:FindFirstChildOfClass("Humanoid")
			if h then cam.CameraSubject = h return end
		end
		local mh = lp.Character and lp.Character:FindFirstChildOfClass("Humanoid")
		if mh then cam.CameraSubject = mh end
	end

	local listF = new("ScrollingFrame", {
		Size = UDim2.new(0, 150, 0, 200), BackgroundColor3 = C_BG, BorderSizePixel = 0, Visible = false,
		CanvasSize = UDim2.new(0, 0, 0, 0), AutomaticCanvasSize = Enum.AutomaticSize.Y, ScrollBarThickness = 4,
	}, gui)
	corner(listF, 8)
	new("UIListLayout", {Padding = UDim.new(0, 3)}, listF)
	M.listF = listF

	local function fillList()
		for _, c in ipairs(listF:GetChildren()) do
			if c:IsA("TextButton") then c:Destroy() end
		end
		for _, p in ipairs(Players:GetPlayers()) do
			if p ~= lp then
				local b = new("TextButton", {
					Size = UDim2.new(1, -8, 0, 26), Text = p.DisplayName, BackgroundColor3 = C_BTN,
					TextColor3 = WHITE, Font = Enum.Font.Gotham, TextSize = 12,
				}, listF)
				corner(b, 6)
				b.MouseButton1Click:Connect(function()
					selected = p
					selRow.Text = "Pilih Player: " .. p.DisplayName
					listF.Visible = false
					if S.Spectate then applySpectate() end
				end)
			end
		end
	end

	selRow = U1.btn("Pilih Player: -", function()
		fillList()
		listF.Position = UDim2.new(0, panel.AbsolutePosition.X + panel.AbsoluteSize.X + 6, 0, panel.AbsolutePosition.Y)
		listF.Visible = not listF.Visible
	end)
	U1.btn("Teleport ke Player", function()
		local my = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
		local tr = selected and selected.Character and selected.Character:FindFirstChild("HumanoidRootPart")
		if my and tr then my.CFrame = tr.CFrame * CFrame.new(0, 0, 3) end
	end)
	U1.tg("Spectate", "Spectate", applySpectate)

	on(Players.PlayerRemoving, function(p)
		if selected == p then
			selected = nil
			selRow.Text = "Pilih Player: -"
		end
	end)
	on(RunService.RenderStepped, function()
		if S.Spectate and selected and selected.Character then
			local h = selected.Character:FindFirstChildOfClass("Humanoid")
			if h and cam.CameraSubject ~= h then cam.CameraSubject = h end
		end
	end)
end

