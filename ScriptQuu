---------------------------------------------------------------- PREDICTION LINE (arah gerak musuh)
local predictGui = new("ScreenGui", { Name = "SQ_Predict", ResetOnSpawn = false }, lp.PlayerGui)
local predictCache = {}
local lastPos = {}

RunService.RenderStepped:Connect(function(dt)
	if not Misc.PredictLine then
		for _, l in predictCache do l:Destroy() end
		table.clear(predictCache)
		return
	end
	local cam2 = workspace.CurrentCamera
	for _, p in Players:GetPlayers() do
		if p ~= lp then
			local oc = p.Character
			local root = oc and oc:FindFirstChild("HumanoidRootPart")
			if root then
				local prev = lastPos[p]
				lastPos[p] = root.Position
				if prev then
					local vel = (root.Position - prev) / dt
					local futurePos = root.Position + vel * 0.5
					local v1 = cam2:WorldToViewportPoint(root.Position)
					local v2 = cam2:WorldToViewportPoint(futurePos)
					if v1.Z > 0 and v2.Z > 0 then
						if not predictCache[p] then
							predictCache[p] = new("Frame", { BackgroundColor3 = Color3.fromRGB(255, 220, 60), BorderSizePixel = 0, AnchorPoint = Vector2.new(0.5, 0.5) }, predictGui)
						end
						local a, b = Vector2.new(v1.X, v1.Y), Vector2.new(v2.X, v2.Y)
						local diff = b - a
						predictCache[p].Size = UDim2.fromOffset(diff.Magnitude, 2)
						predictCache[p].Position = UDim2.fromOffset((a.X + b.X) / 2, (a.Y + b.Y) / 2)
						predictCache[p].Rotation = math.deg(math.atan2(diff.Y, diff.X))
					end
				end
			end
		end
	end
end)

